-- The 2024 submenu closes on any mouse release or tap; buttons
-- that handle the click themselves (rows, pins, the nine_dot)
-- mark it, so only "outside" clicks close it here.
local function DismissSubmenuFromInput(InputTime, Window)
    if not State.SubMenuOpen then
        return
