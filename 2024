--============================================================
-- HEALTH BAR
--============================================================
-- Unibar/HealthBar.lua under the open pill, TopBar HealthBar
-- beside the closed one. Colours use the 2024 interpolation.
--============================================================

local HealthSamples = {
    { Color = HEALTH_RED, Position = 0.1 },
    { Color = HEALTH_YELLOW, Position = 0.5 },
    { Color = HEALTH_GREEN, Position = 0.8 },
}

local function GetHealthColor(Percent)
    if Percent <= 0.1 then
        return HEALTH_RED
    elseif Percent >= 0.8 then
        return HEALTH_GREEN
    end

    -- Shepard's interpolation.
    local R, G, B, Total = 0, 0, 0, 0

    for _, Sample in ipairs(HealthSamples) do
        local Distance = Percent - Sample.Position

        if Distance == 0 then
            return Sample.Color
        end

        local Weight = 1 / (Distance * Distance)

        R += Sample.Color.R * Weight
        G += Sample.Color.G * Weight
        B += Sample.Color.B * Weight
        Total += Weight
    end

    return Color3.new(R / Total, G / Total, B / Total)
end

ApplyHealth = function()
    local Percent = State.Health
    local Enabled = true

    pcall(function()
        Enabled = StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Health)
    end)

    local Hurt = Enabled and Percent < 1
    local Color = GetHealthColor(Percent)

    if UnibarHealthBar then
        local Distance = (0.5 - Percent) * 2

        UnibarHealthBar.Visible = Hurt and State.ChromeOpen
        UnibarHealthBar.Size = UDim2.new(
            Percent,
            Round(ICON_CELL_WIDTH / 4 * Distance),
            0,
            2
        )
    end

    if UnibarHealthFill then
        UnibarHealthFill.BackgroundColor3 = Color
    end

    if StackedHealthBar then
        StackedHealthBar.Visible = Hurt and not State.ChromeOpen
    end

    if StackedHealthFill then
        StackedHealthFill.Size = UDim2.fromScale(Percent, 1)
        StackedHealthFill.ImageColor3 = Color
    end
end

do
    local HumanoidConnections = {}

    local function ClearHumanoid()
        for _, Connection in ipairs(HumanoidConnections) do
            Connection:Disconnect()
        end

        table.clear(HumanoidConnections)
    end

    local function UpdateFromHumanoid(Humanoid)
        if Humanoid and Humanoid.MaxHealth > 0 then
            State.Health = math.clamp(Humanoid.Health / Humanoid.MaxHealth, 0, 1)
        else
            -- No humanoid (or none yet): nothing to report.
            State.Health = 1
        end

        ApplyHealth()
    end

    local function ObserveCharacter(Character)
        ClearHumanoid()

        if not Character then
            UpdateFromHumanoid(nil)
            return
        end

        local Humanoid = Character:FindFirstChildOfClass("Humanoid")

        if not Humanoid then
            table.insert(HumanoidConnections, Connect(Character.ChildAdded, function(Child)
                if Child:IsA("Humanoid") then
                    ObserveCharacter(Character)
                end
            end))

            UpdateFromHumanoid(nil)
            return
        end

        local function Update()
            UpdateFromHumanoid(Humanoid)
        end

        table.insert(HumanoidConnections, Connect(Humanoid.HealthChanged, Update))
