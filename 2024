--============================================================
-- MOST RECENTLY USED / PINS
--============================================================
-- ChromeService:setRecentlyUsed / setUserPin (2024). Pins share
-- the slot budget with recently used items; backpack, emotes,
-- chat and leaderboard can be pinned up to the slot limit.
-- Report and Dropdown are always in the bar, so pinning them only
-- keeps them visible while the unibar is closed.
--============================================================

local function PinnedRecentCount()
    local Count = 0

    for Id in pairs(RecentCapable) do
        if State.Pinned[Id] then
            Count += 1
        end
    end

    return Count
end

local function RebuildRecent()
    table.clear(State.Recent)

    local Slots = State.SlotLimit - PinnedRecentCount()
    local Record = State.RecentRecord
    local Start = math.max(1, #Record - Slots + 1)

    if Slots > 0 then
        for Index = Start, #Record do
            table.insert(State.Recent, Record[Index])
        end
    end
end

local function SetRecentlyUsed(Id, Force)
    if not RecentCapable[Id] or State.Pinned[Id] then
        return
    end

    if not Force and table.find(State.Recent, Id) then
        return
    end

    local Index = table.find(State.RecentRecord, Id)

    if Index then
        table.remove(State.RecentRecord, Index)
    end

    table.insert(State.RecentRecord, Id)

    RebuildRecent()
end

local function PinsFull()
    return PinnedRecentCount() >= State.SlotLimit
end

local function TogglePin(Id)
    if State.Pinned[Id] then
        State.Pinned[Id] = nil

        local Index = table.find(State.PinOrder, Id)

        if Index then
            table.remove(State.PinOrder, Index)
        end
    else
        if RecentCapable[Id] and PinsFull() then
            return
        end

        State.Pinned[Id] = true
        table.insert(State.PinOrder, Id)

        local Index = table.find(State.RecentRecord, Id)

        if Index then
            table.remove(State.RecentRecord, Index)
        end
    end

    RebuildRecent()
    RelayoutUnibar()
    RefreshPins()
end

-- When the slot limit shrinks (phone rotated to portrait), 2024
-- keeps only the newest pins that still fit.
local function TrimPins()
    while PinnedRecentCount() > State.SlotLimit do
        for Index, Id in ipairs(State.PinOrder) do
            if RecentCapable[Id] then
                State.Pinned[Id] = nil
                table.remove(State.PinOrder, Index)
                break
            end
        end
    end
end

