--============================================================
-- Each animation is one NumberValue tweened from 0 to 1, the same
-- way the 2024 code drives everything from one spring binding.
--============================================================

local AnimationFolder = Instance.new("Folder")
AnimationFolder.Name = "__OldChrome2024Animation"
AnimationFolder.Parent = TopBarApp

local ActiveTweens = {}

local function NewValue(Name, Initial)
    local Value = Instance.new("NumberValue")
    Value.Name = Name
    Value.Value = Initial
    Value.Parent = AnimationFolder
    return Value
end

local function AnimateValue(Value, Target, Info)
    local Previous = ActiveTweens[Value]

    if Previous then
        Previous:Cancel()
        ActiveTweens[Value] = nil
    end

    if not Info or Value.Value == Target then
        Value.Value = Target
        return
    end

    local Ok, Tween = pcall(
        TweenService.Create,
        TweenService,
        Value,
        Info,
        { Value = Target }
    )

    if Ok and Tween then
        ActiveTweens[Value] = Tween
        Tween:Play()
    else
        Value.Value = Target
    end
end

-- 0 = closed, 1 = open.
local ToggleValue = NewValue("Toggle", 0)

-- 0 = prior open layout, 1 = current open layout.
local ReflowValue = NewValue("Reflow", 1)

-- 0 = submenu hidden, 1 = submenu shown.
local SubmenuValue = NewValue("Submenu", 0)

--============================================================
-- INTERACTABLE (UIBlox ControlState)
--============================================================
-- Default / Hover / Pressed. Hover only exists for a mouse; on
-- touch the highlight shows while pressed and clears on release,
-- so it can no longer get stuck on after a tap.
--============================================================

local function BindInteractable(Button, OnChanged)
    if not Button or not Button:IsA("GuiObject") then
        return nil
    end

    local Control = {
        Hovered = false,
        Pressed = false,
        Disabled = false,
        Last = "Default",
    }

    local function Emit()
        local Name = "Default"

        if not Control.Disabled then
            if Control.Pressed then
                Name = "Pressed"
            elseif Control.Hovered then
                Name = "Hover"
            end
        end

        if Control.Last ~= Name then
            Control.Last = Name
            OnChanged(Name)
        end
    end

    Control.Emit = Emit

    function Control.Reset(KeepHover)
        Control.Pressed = false

        if not KeepHover then
            Control.Hovered = false
        end

        Emit()
    end

    Connect(Button.MouseEnter, function()
        if MouseHoverAllowed() then
            Control.Hovered = true
            Emit()
        end
    end)

    Connect(Button.MouseLeave, function()
        Control.Hovered = false
        Control.Pressed = false
        Emit()
    end)

    Connect(Button.InputBegan, function(Input)
        local Type = Input.UserInputType

        if Type == Enum.UserInputType.MouseButton1
            or Type == Enum.UserInputType.Touch
        then
            Control.Pressed = true
            Emit()
        end
    end)

    Connect(Button.InputEnded, function(Input)
        local Type = Input.UserInputType

        if Type == Enum.UserInputType.MouseButton1
            or Type == Enum.UserInputType.Touch
        then
            Control.Pressed = false

            if Type == Enum.UserInputType.Touch then
                Control.Hovered = false
            end

            Emit()
        end
    end)

    table.insert(Interactables, Control)

    return Control
end

local function ResetInteractables(KeepHover)
    for _, Control in ipairs(Interactables) do
        Control.Reset(KeepHover)
    end
end

local function OnActivated(Button, Callback)
    if not Button or not Button:IsA("GuiButton") then
        return
    end

    SetProperty(Button, "Active", true)
    SetProperty(Button, "Interactable", true)

    Connect(Button.Activated, function()
        if not Alive then
            return
        end

        State.LastOwnActivation = os.clock()
        Callback()
    end)
end

--============================================================
-- NATIVE COREUI ACCESS
--============================================================

local function GetConnectionList(Signal)
    if type(getconnections) ~= "function" then
        return nil
    end

    local Ok, Result = pcall(getconnections, Signal)

    if Ok and type(Result) == "table" then
        return Result
    end

    return nil
end

local function GetHandler(Item)
    local Handler = nil

    pcall(function()
        Handler = Item.Function
    end)

    if type(Handler) == "function" then
        return Handler
    end

    return nil
end

-- Calls a signal's connected handlers directly. A plain Lua call
-- cannot generate input. False when no handler can be reached (some
-- executors hide the CoreScripts' functions).
local function CallHandlers(Signal)
    local List = GetConnectionList(Signal)
    local Called = false

    for _, Item in ipairs(List or {}) do
        local Handler = GetHandler(Item)

        if Handler then
            Called = true

            task.spawn(function()
                pcall(Handler)
            end)
        end
    end

    return Called
end

-- firesignal / :Fire(). How an executor implements these is unknown;
-- some click the button with simulated mouse input, which switches a
-- phone to keyboard-and-mouse mode.
local function SimulateSignal(Signal)
    if type(firesignal) == "function" and pcall(firesignal, Signal) then
        return true
    end

    local List = GetConnectionList(Signal)

    if List and #List > 0 then
        for _, Item in ipairs(List) do
            pcall(function()
                Item:Fire()
            end)
        end

        return true
    end

    return false
end

local function FireSignal(Signal)
    return CallHandlers(Signal) or SimulateSignal(Signal)
end

-- Invisible, full-screen and above everything (our ScreenGui has the
-- highest DisplayOrder). Shown for a couple of frames so a synthetic
-- tap lands on it and nowhere else, whatever its exact coordinates.
local TouchSink = Instance.new("ImageButton")
TouchSink.Name = "__OldChrome2024TouchSink"
TouchSink.BackgroundTransparency = 1
TouchSink.ImageTransparency = 1
TouchSink.AutoButtonColor = false
TouchSink.Active = true
TouchSink.Visible = false
TouchSink.Position = UDim2.fromOffset(-200, -200)
TouchSink.Size = UDim2.new(1, 400, 1, 400)
TouchSink.ZIndex = 100000
TouchSink.Parent = TopBarApp

local TOUCH_SINK_ID = 9137

-- Fingers on the screen right now. Nothing may cover the screen while
-- one is down: a held jump button whose release lands on a cover never
-- hears it, and stays pressed.
local ActiveTouches = {}

Connect(UserInputService.TouchStarted, function(Input)
    ActiveTouches[Input] = true
end)

Connect(UserInputService.TouchEnded, function(Input)
    ActiveTouches[Input] = nil
end)

local function FingersDown()
    for Input in pairs(ActiveTouches) do
        local Ok, InputState = pcall(function()
            return Input.UserInputState
        end)

        -- A touch whose end was never reported is not held any more.
        if not Ok
            or InputState == Enum.UserInputState.End
            or InputState == Enum.UserInputState.Cancel
        then
            ActiveTouches[Input] = nil
        end
    end

    return next(ActiveTouches) ~= nil
end

-- Waits (up to Timeout) for every finger to leave the screen.
local function WaitForFingersUp(Timeout)
    local Deadline = os.clock() + Timeout

    while Alive and FingersDown() and os.clock() < Deadline do
        task.wait()
    end

    return not FingersDown()
end

-- A synthetic key switches a touch device to keyboard-and-mouse mode:
-- a cursor appears and the thumbstick / jump button hide. One
-- synthetic tap on the sink switches it straight back to touch.
local function RestoreTouchInput()
    if not VirtualInputManager
        or not UserInputService.TouchEnabled
        or State.SyntheticTouch
        or State.NoTouchEvents
        or FingersDown()
    then
        return
    end

    local Size = GetViewportSize()
    local X, Y = Size.X / 2, Size.Y / 2

    State.SyntheticTouch = true
    State.LastOwnActivation = os.clock()
    TouchSink.Visible = true

    if not pcall(function()
        VirtualInputManager:SendTouchEvent(TOUCH_SINK_ID, Enum.UserInputState.Begin.Value, X, Y)
        task.wait()
        VirtualInputManager:SendTouchEvent(TOUCH_SINK_ID, Enum.UserInputState.End.Value, X, Y)
    end) then
        -- The executor has no touch events; never try again.
        State.NoTouchEvents = true
    end

    task.wait()
    TouchSink.Visible = false
    State.SyntheticTouch = false
end

-- Native paths are always tried first. Without AllowOnTouch, touch
-- devices never get synthetic keys; with it (the Escape menu, which
-- has no other way in on some executors) touch mode is restored
-- right after the key.
local function SendKey(KeyCode, AllowOnTouch)
    if not VirtualInputManager then
        return false
    end

    local OnTouch = not IsKeyboardAndMouse()

    if OnTouch and not AllowOnTouch then
        return false
    end

    -- Our own InputBegan handler must not treat this as a user press.
    SyntheticKeyUntil[KeyCode] = os.clock() + 0.35

    local Ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, KeyCode, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, KeyCode, false, game)
    end)

    if OnTouch then
        task.wait()
        RestoreTouchInput()
    end

    return Ok
end

local function MetaIndex(Table)
    local GetMeta = getrawmetatable or getmetatable
    local Ok, Meta = pcall(GetMeta, Table)

    if Ok and type(Meta) == "table" then
        local Index = rawget(Meta, "__index")

        if type(Index) == "table" then
            return Index
        end
    end

    return nil
end

-- Identifies the CoreScript singletons by their exact shape.
-- Only rawget is used so strict metatables can never error.
local function ClassifyNative(Value)
    local ModuleName = rawget(Value, "ModuleName")

    if ModuleName == "SettingsMenu" then
        if type(rawget(Value, "SetVisibility")) == "function"
            and type(rawget(Value, "Instance")) == "table"
        then
            Native.Settings = Value
        end
    elseif ModuleName == "Backpack" then
        if typeof(rawget(Value, "StateChanged")) == "Instance" then
            Native.Backpack = Value
        end
    elseif typeof(rawget(Value, "SetVisibleChangedEvent")) == "Instance" then
        local Index = MetaIndex(Value)

        if Index
            and type(rawget(Index, "SetVisibility")) == "function"
            and type(rawget(Index, "GetSetVisible")) == "function"
        then
            Native.PlayerList = Value
        end
    elseif type(rawget(Value, "_integrations")) == "table"
        and type(rawget(Value, "_subMenuConfig")) == "table"
    then
        Native.Chrome = Value
    elseif type(rawget(Value, "controllers")) == "table" then
        -- The game's PlayerModule ControlModule (thumbstick / jump).
        local Index = MetaIndex(Value)

        if Index
            and type(rawget(Index, "SwitchToController")) == "function"
            and type(rawget(Index, "UpdateTouchGuiVisibility")) == "function"
        then
            Native.Controls = Value
        end
    end
end

local function ScanNativeModules()
    if type(getgc) ~= "function" then
        return false
    end

    local Ok, Objects = pcall(getgc, true)

    if not Ok or type(Objects) ~= "table" then
        return false
    end

    local Count = 0

    for _, Value in pairs(Objects) do
        if type(Value) == "table" then
            pcall(ClassifyNative, Value)
        end

        Count += 1

        -- Spread the scan over frames instead of one long hitch.
        if Count % 25000 == 0 then
            task.wait()
        end
    end

    return true
end

local function ActivateChromeIntegration(Id)
    local Chrome = Native.Chrome
    local List = Chrome and rawget(Chrome, "_integrations")
    local Integration = type(List) == "table" and rawget(List, Id)
    local Activated = type(Integration) == "table" and rawget(Integration, "activated")

    if type(Activated) ~= "function" then
        return false
    end

    task.spawn(function()
        pcall(Activated, Integration)
    end)

    return true
end

-- Last resort: the disabled native unibar still has its buttons.
local function FireNativeHitArea(Id)
    for _, Object in ipairs(NativeTopBars) do
        local Button = Object:FindFirstChild("IconHitArea_" .. Id, true)

        if Button and Button:IsA("GuiButton") then
            return FireSignal(Button.Activated)
        end
    end

    return false
end

-- The disabled native top bar's own Roblox button
-- (MenuIconHolder / MenuIcon > MenuIconTriggerPoint). Its handler
-- is SettingsHub:ToggleVisibility, so firing it needs no key event.
-- Roblox's own menu button once it sits inside ours (MENU ICON).
local RealMenuButton = { Button = nil, Watch = {}, MenuChanges = 0 }

local function FindNativeMenuButton()
    local Real = RealMenuButton.Button

    if Real and Real.Parent then
        return Real
    end

    for _, Object in ipairs(NativeTopBars) do
        for _, Name in ipairs({ "MenuIconHolder", "MenuIcon", "MenuIconTriggerPoint" }) do
            local Holder = Object:FindFirstChild(Name, true)
            local Button = Holder
                and (Holder:IsA("GuiButton") and Holder
                    or Holder:FindFirstChildWhichIsA("GuiButton", true))

            if Button then
                return Button
            end
        end
    end

    return nil
end

local function FireNativeMenuButton()
    local Button = FindNativeMenuButton()

    return Button ~= nil and FireSignal(Button.Activated)
end

