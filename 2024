-- REPORT (trust_and_safety)
--============================================================
-- 2024: opens SettingsHub on the Report page; pressing it again
-- on that page closes the menu. The icon is "on" while the Report
-- page is the current page.
--============================================================

local function FindReportButton()
    if not RobloxGui then
        return nil
    end

    local Best, BestScore = nil, 0

    for _, Object in ipairs(RobloxGui:GetDescendants()) do
        if Object:IsA("GuiButton") and Object.Visible then
            local Score = 0
            local Name = string.lower(Object.Name)

            if Name == "report" then
                Score += 200
            elseif string.find(Name, "report", 1, true) then
                Score += 100
            end

            for _, Child in ipairs(Object:GetDescendants()) do
                if Child:IsA("TextLabel") or Child:IsA("TextButton") then
                    local Text = string.lower(Child.Text)

                    if Text == "report" then
                        Score += 150
                    elseif string.find(Text, "report", 1, true) then
                        Score += 75
                    end
                end
            end

            if Score > BestScore then
                Best, BestScore = Object, Score
            end
        end
    end

    return Best
end

local function ActivateReport()
    local Settings = Native.Settings

    if Settings then
        task.spawn(function()
            pcall(function()
                local Page = rawget(Settings, "Instance").ReportAbusePage

                if Settings:GetVisibility() then
                    if Native.ReportPageOpen then
                        Settings:SetVisibility(false)
                    else
                        Settings:SwitchToPage(Page, true)
                    end
                else
                    Settings:SetVisibility(true, false, Page)
                end
            end)
        end)

        return
    end

    -- Without SettingsHub: open the Escape menu and press its
    -- Report tab, like the previous build did.
    if State.Active.report then
        State.Active.report = false
        UpdateIconStates()

        task.spawn(SetEscapeMenuOpen, false)

        return
    end

    State.Active.report = true
    UpdateIconStates()

    task.spawn(function()
        SetEscapeMenuOpen(true)

        local Deadline = os.clock() + 5
        local Button

        repeat
            task.wait(0.05)
            Button = GuiService.MenuIsOpen and FindReportButton()
        until Button or os.clock() > Deadline or not Alive

        if Button then
            if not FireSignal(Button.Activated) then
                FireSignal(Button.MouseButton1Click)
            end
        else
            warn("[OLD CHROME] Could not locate the real Roblox Report button.")
        end
    end)
end

