    NineDotMenu.ClipsDescendants = true
    ScrollingFrame.ClipsDescendants = true
end)

-- The 2024 submenu closes on any mouse release or tap; buttons
-- that handle the click themselves (rows, pins, the nine_dot)
-- mark it, so only "outside" clicks close it here.
local function DismissSubmenuFromInput(InputTime, Window)
    if not State.SubMenuOpen then
        return
    end

    if math.abs(State.LastOwnActivation - InputTime) < Window then
        return
    end

    CloseSubmenu()
end

Connect(UserInputService.InputEnded, function(Input)
    local Type = Input.UserInputType

    if Type == Enum.UserInputType.MouseButton1 then
        local InputTime = os.clock()

        task.defer(function()
            DismissSubmenuFromInput(InputTime, 0.1)
            ResetInteractables(true)
        end)
    elseif Type == Enum.UserInputType.Touch then
        task.defer(ResetInteractables, false)
    end
end)

Connect(UserInputService.TouchStarted, function(Touch)
    State.LastTouchStart = Vector2.new(Touch.Position.X, Touch.Position.Y)
end)

Connect(UserInputService.TouchTap, function(Positions)
    -- FixSubmenuCloseIOS: a tap that moved is a drag, not a tap.
    local First = type(Positions) == "table" and Positions[1]

    if typeof(First) == "Vector2"
        and State.LastTouchStart
        and (First - State.LastTouchStart).Magnitude > 4
    then
        return
    end

    local InputTime = os.clock()

    task.delay(0.05, function()
        DismissSubmenuFromInput(InputTime, 0.3)
    end)
end)

Connect(UserInputService.LastInputTypeChanged, function(Type)
    if Type == Enum.UserInputType.Touch then
        ResetInteractables(false)
    end
end)

