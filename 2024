--============================================================
-- TOUCH CONTROLS GUARD
--============================================================
-- On phones, opening and closing the Escape menu from here can
-- leave the game's thumbstick and jump button hidden after the
-- menu is gone, even after real taps. The input state from before
-- the menu opened is remembered, and once the menu has closed
-- whatever changed is put back.
--============================================================

local TouchGuard = {
    Baseline = nil,
    Generation = 0,
    -- The controls were shown before an earlier menu and never came
    -- back; the next menu still counts them as shown.
    Lost = false,
}

-- Phones and tablets, not touch-screen laptops.
function TouchGuard.IsTouchDevice()
    return UserInputService.TouchEnabled == true
        and (IsMobileDevice() or not UserInputService.MouseEnabled)
end

function TouchGuard.Read(Object, Property)
    local Ok, Value = pcall(function()
        return Object[Property]
    end)

    if Ok then
        return Value
    end

    return nil
end

function TouchGuard.Short(Value)
    return string.match(tostring(Value), "[^%.]+$")
end

function TouchGuard.FindTouchGui()
    local Player = Players.LocalPlayer
    local PlayerGui = Player and Player:FindFirstChildOfClass("PlayerGui")
    local TouchGui = PlayerGui and PlayerGui:FindFirstChild("TouchGui")

    if TouchGui and TouchGui:IsA("ScreenGui") then
        return TouchGui
    end

    return nil
end

-- true / false for the PlayerModule's thumbstick and jump button,
-- nil when the game has no TouchGui (its own controls).
function TouchGuard.ControlsShown()
    local TouchGui = TouchGuard.FindTouchGui()
    local Frame = TouchGui and TouchGui:FindFirstChild("TouchControlFrame")

    if not Frame then
        return nil
    end

    if not TouchGui.Enabled or not Frame.Visible then
        return false
    end

    for _, Child in ipairs(Frame:GetChildren()) do
        if Child:IsA("GuiObject") and Child.Visible then
            return true
        end
    end

    return false
end

function TouchGuard.InTouchMode()
    local Preferred = TouchGuard.Read(UserInputService, "PreferredInput")

    if Preferred ~= nil then
        return Preferred == Enum.PreferredInput.Touch
    end

    return UserInputService:GetLastInputType() == Enum.UserInputType.Touch
end

function TouchGuard.Snapshot()
    if not TouchGuard.IsTouchDevice() then
        return nil
    end

    local Shown = TouchGuard.ControlsShown()

    if Shown == false and TouchGuard.Lost then
        Shown = true
    end

    return {
        Shown = Shown,
        Enabled = TouchGuard.Read(GuiService, "TouchControlsEnabled"),
        Modal = TouchGuard.Read(UserInputService, "ModalEnabled"),
        Cursor = TouchGuard.Read(UserInputService, "OverrideMouseIconBehavior"),
        GamepadCursor = GamepadService and TouchGuard.Read(GamepadService, "GamepadCursorEnabled"),
    }
end

-- Puts a property back to its value from before the menu opened.
function TouchGuard.Restore(Object, Property, Before, Fixed, Label)
    if Before == nil then
        return
    end

    local Now = TouchGuard.Read(Object, Property)

    if Now ~= nil
        and Now ~= Before
        and pcall(function()
            Object[Property] = Before
        end)
    then
        table.insert(Fixed, Label)
    end
end

-- The PlayerModule listens to TouchControlsEnabled and works out
-- its controls again (UpdateMovementMode) when it changes.
function TouchGuard.RefreshControls()
    if not GuiService.TouchControlsEnabled then
        return false
    end

    pcall(function()
        GuiService.TouchControlsEnabled = false
    end)

    task.wait()

    pcall(function()
        GuiService.TouchControlsEnabled = true
    end)

    task.wait(0.1)

    return TouchGuard.ControlsShown() == true
end

-- Last resort: switch the ControlModule (found with getgc) to its
-- touch controller directly.
function TouchGuard.ForceControls()
    local Controls = Native.Controls
    local Index = Controls and MetaIndex(Controls)

    if not Index then
        return false
    end

    pcall(function()
        if rawget(Controls, "controlsEnabled") == false then
            rawget(Index, "Enable")(Controls, true)
        end
    end)

    pcall(function()
        local Module, Success = rawget(Index, "SelectTouchModule")(Controls)

        if Module and Success then
            rawget(Index, "SwitchToController")(Controls, Module)
        end
    end)

    pcall(function()
        local TouchGui = rawget(Controls, "touchGui") or TouchGuard.FindTouchGui()
        TouchGui.Enabled = true
    end)

    pcall(function()
        rawget(Index, "UpdateActiveControlModuleEnabled")(Controls)
    end)

    task.wait(0.1)

    return TouchGuard.ControlsShown() == true
end

-- One pass over everything the menu may have left behind. Returns
-- what it changed.
function TouchGuard.Repair(Baseline)
    local Fixed = {}

    if GuiService.MenuIsOpen then
        return Fixed
    end

    -- SettingsHub forces the cursor on while it is open.
    TouchGuard.Restore(UserInputService, "OverrideMouseIconBehavior", Baseline.Cursor, Fixed, "cursor")
    TouchGuard.Restore(UserInputService, "ModalEnabled", Baseline.Modal, Fixed, "modal")
    TouchGuard.Restore(GuiService, "TouchControlsEnabled", Baseline.Enabled, Fixed, "touch flag")

    if GamepadService
        and Baseline.GamepadCursor == false
        and TouchGuard.Read(GamepadService, "GamepadCursorEnabled") == true
        and pcall(function()
            GamepadService:DisableGamepadCursor()
        end)
    then
        table.insert(Fixed, "gamepad cursor")
    end

    -- SettingsHub's "stop the character" binding, in case its close
    -- never finished. Nothing happens when it is not bound.
    if ContextActionService then
        pcall(function()
            ContextActionService:UnbindCoreAction("RbxSettingsHubStopCharacter")
        end)
    end

    if not TouchGuard.InTouchMode() then
        RestoreTouchInput()
        task.wait(0.05)
        table.insert(Fixed, TouchGuard.InTouchMode() and "touch mode" or "touch mode failed")
    end

    if Baseline.Shown and TouchGuard.ControlsShown() == false then
        if TouchGuard.RefreshControls() then
            table.insert(Fixed, "controls refreshed")
        elseif TouchGuard.ForceControls() then
            table.insert(Fixed, "controls forced")
        end
    end

    return Fixed
end

function TouchGuard.Describe()
    local Shown = TouchGuard.ControlsShown()
    local Controls = Native.Controls
    local Module = "not found"

    if Controls then
        Module = rawget(Controls, "controlsEnabled") == false and "disabled" or "found"
    end

    return string.format(
        "input %s | flag %s | cursor %s | gui %s | module %s | menu %s",
        TouchGuard.Short(TouchGuard.Read(UserInputService, "PreferredInput") or UserInputService:GetLastInputType()),
        TouchGuard.Short(TouchGuard.Read(GuiService, "TouchControlsEnabled")),
        TouchGuard.Short(TouchGuard.Read(UserInputService, "OverrideMouseIconBehavior")),
        Shown == nil and "none" or (Shown and "shown" or "hidden"),
        Module,
        State.MenuPath or "?"
    )
end

-- What was repaired (or what is still wrong) goes to the console and
-- getgenv().OldChrome2024Status.
function TouchGuard.Report(Fixed, Baseline)
    local StillHidden = Baseline.Shown == true and TouchGuard.ControlsShown() == false

    TouchGuard.Lost = StillHidden

    if #Fixed == 0 and not StillHidden then
        return
    end

    local Text = StillHidden and "Touch controls still hidden" or "Repaired after the menu closed"

    if #Fixed > 0 then
        Text ..= " (" .. table.concat(Fixed, ", ") .. ")"
    end

    Note(Text .. " | " .. TouchGuard.Describe())
end

-- Runs whenever the menu closes: once after the close animation,
-- then again for anything that changes a little later.
function TouchGuard.OnMenuClosed()
    local Baseline = TouchGuard.Baseline

    if not Baseline or GuiService.MenuIsOpen then
        return
    end

    TouchGuard.Generation += 1
    local Generation = TouchGuard.Generation

    task.spawn(function()
        local Fixed = {}

        for _, Delay in ipairs({ 0.4, 0.6, 1.5 }) do
            task.wait(Delay)

            -- Never while a finger is down: refreshing the controls
            -- under a held jump button would leave it stuck.
            WaitForFingersUp(8)

            if not Alive or Generation ~= TouchGuard.Generation or GuiService.MenuIsOpen then
                return
            end

            for _, Name in ipairs(TouchGuard.Repair(Baseline)) do
                if not table.find(Fixed, Name) then
                    table.insert(Fixed, Name)
                end
            end
        end

        TouchGuard.Baseline = nil
        TouchGuard.Report(Fixed, Baseline)
    end)
end

--============================================================
-- CURSOR GUARD
--============================================================
-- A phone or tablet never needs a cursor, yet SettingsHub forces one
-- on (ForceShow) while the Escape menu is open, and any stray mouse
-- event shows one. It is kept hidden; whatever the game or the
-- CoreScripts last asked for is put back on unload.
--============================================================

local CursorGuard = {
    Active = false,
    Wanted = nil,
}

function CursorGuard.Apply()
    if not CursorGuard.Active or not Alive then
        return
    end

    local Current = TouchGuard.Read(UserInputService, "OverrideMouseIconBehavior")

    if Current == nil or Current == Enum.OverrideMouseIconBehavior.ForceHide then
        return
    end

    CursorGuard.Wanted = Current

    pcall(function()
        UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.ForceHide
    end)
end

function CursorGuard.Release()
    if not CursorGuard.Active then
        return
    end

    CursorGuard.Active = false

    pcall(function()
        UserInputService.OverrideMouseIconBehavior = CursorGuard.Wanted
            or Enum.OverrideMouseIconBehavior.None
    end)
end

if Config.HideCursorOnTouch and TouchGuard.IsTouchDevice() then
    CursorGuard.Active = true
    CursorGuard.Wanted = TouchGuard.Read(UserInputService, "OverrideMouseIconBehavior")
    CursorGuard.Apply()

    pcall(function()
        Connect(UserInputService:GetPropertyChangedSignal("OverrideMouseIconBehavior"), CursorGuard.Apply)
    end)

    local Cleanup = LocalEnv.__OldChrome2024Cleanup

    LocalEnv.__OldChrome2024Cleanup = function()
        CursorGuard.Release()
        Cleanup()
    end
end

--============================================================
-- TOUCH MODE FOR GAME SCRIPTS
--============================================================
-- One keyboard or mouse event (real or fake: another script's
-- VirtualInputManager click, a key an executor sent) makes Roblox treat
-- a phone as a computer: PreferredInput becomes KeyboardAndMouse and
-- MouseEnabled / KeyboardEnabled can stay true. The PlayerModule then
-- hides the thumbstick and jump button and uses the computer movement
-- mode (Click to Move); the Settings page lists computer options and a
-- Shift Lock switch.
--
-- On a phone, scripts other than this one (checkcaller) read
-- PreferredInput as Touch and MouseEnabled / KeyboardEnabled as false,
-- and other scripts' fake key presses are dropped. Fake mouse clicks
-- still go through: on some executors firesignal is one, and it is the
-- only thing that reaches Roblox's menu button there.
-- The hooks are installed once per session; later copies and unload
-- only switch them on and off.
--============================================================

-- touch-safe 8 kept a PreferredInput-only hook here: switch it off.
if type(LocalEnv.__OldChrome2024TouchSpoof) == "table" then
    LocalEnv.__OldChrome2024TouchSpoof.Enabled = false
end

local InputSpoof = LocalEnv.__OldChrome2024InputSpoof

if type(InputSpoof) ~= "table" then
    InputSpoof = {
        Enabled = false,
        Values = {},
        IndexInstalled = false,
        NamecallInstalled = false,
        Blocked = 0,
        -- VirtualInputManager methods other scripts may not use on a phone.
        Methods = {
            SendKeyEvent = "drop",
            SendTextInputCharacterEvent = "drop",
        },
    }

    LocalEnv.__OldChrome2024InputSpoof = InputSpoof
end

InputSpoof.Enabled = false
InputSpoof.Methods.SendMouseButtonEvent = nil
InputSpoof.Methods.SendMouseMoveEvent = nil
InputSpoof.Methods.SendMouseMoveDeltaEvent = nil
InputSpoof.Methods.SendMouseWheelEvent = nil
InputSpoof.Methods.SendScroll = nil

do
    local TouchOk, Touch = pcall(function()
        return Enum.PreferredInput.Touch
    end)

    local Wanted = Config.SpoofTouchInput
        and Config.KeepTouchMode
        and IsMobileDevice()
        and type(hookmetamethod) == "function"
        and type(checkcaller) == "function"

    if Wanted then
        local Wrap = type(newcclosure) == "function" and newcclosure
            or function(Function)
                return Function
            end

        InputSpoof.Values.MouseEnabled = false
        InputSpoof.Values.KeyboardEnabled = false

        if TouchOk and TouchGuard.Read(UserInputService, "PreferredInput") ~= nil then
            InputSpoof.Values.PreferredInput = Touch
        end

        if not InputSpoof.IndexInstalled then
            local Service = UserInputService
            local Values = InputSpoof.Values
            local OldIndex = nil

            pcall(function()
                OldIndex = hookmetamethod(game, "__index", Wrap(function(Self, Key)
                    if InputSpoof.Enabled and Self == Service and not checkcaller() then
                        local Value = Values[Key]

                        if Value ~= nil then
                            return Value
                        end
                    end

                    return OldIndex(Self, Key)
                end))
            end)

            InputSpoof.IndexInstalled = type(OldIndex) == "function"
        end

        if not InputSpoof.NamecallInstalled
            and VirtualInputManager
            and type(getnamecallmethod) == "function"
        then
            local Vim = VirtualInputManager
            local Methods = InputSpoof.Methods
            local OldNamecall = nil

            pcall(function()
                OldNamecall = hookmetamethod(game, "__namecall", Wrap(function(Self, ...)
                    if Self == Vim and InputSpoof.Enabled then
                        local Action = Methods[getnamecallmethod()]

                        if Action == "drop" then
                            InputSpoof.Blocked += 1
                            return nil
                        end
                    end

                    return OldNamecall(Self, ...)
                end))
            end)

            InputSpoof.NamecallInstalled = type(OldNamecall) == "function"
        end

        InputSpoof.Enabled = InputSpoof.IndexInstalled
    end

    local Cleanup = LocalEnv.__OldChrome2024Cleanup

    LocalEnv.__OldChrome2024Cleanup = function()
        InputSpoof.Enabled = false
        Cleanup()
    end

    Status.InputSpoof = InputSpoof.Enabled
    Status.FakeInputGuard = InputSpoof.Enabled and InputSpoof.NamecallInstalled

    -- Controls the PlayerModule already hid before this ran: make it
    -- look again, now that it reads Touch.
    if InputSpoof.Enabled and not TouchGuard.InTouchMode() then
        task.defer(function()
            if WaitForFingersUp(5) and TouchGuard.ControlsShown() == false then
                TouchGuard.RefreshControls()
            end
        end)
    end
end

-- A phone never has shift lock. The Settings page shows its switch
-- whenever Roblox believes a keyboard and mouse are connected.
if TouchGuard.IsTouchDevice() and RobloxGui then
    local function HideShiftLockRow(Object)
        if Object.Name ~= "Shift Lock SwitchFrame" or not Object:IsA("GuiObject") then
            return
        end

        Object.Visible = false

        Connect(Object:GetPropertyChangedSignal("Visible"), function()
            if Alive and Object.Visible then
                Object.Visible = false
            end
        end)
    end

    for _, Object in ipairs(RobloxGui:GetDescendants()) do
        pcall(HideShiftLockRow, Object)
    end

    Connect(RobloxGui.DescendantAdded, function(Object)
        pcall(HideShiftLockRow, Object)
    end)
end

--============================================================
-- TOUCH MODE KEEPER
--============================================================
-- One keyboard or mouse event (a fake click from another script, a
-- key the executor sent) switches a phone to keyboard-and-mouse mode:
-- the GUI shows keyboard hints and the thumbstick hides. A phone is
-- never really used that way, so touch mode is put straight back with
-- one synthetic tap on the sink. Never while a TextBox has focus: the
-- on-screen keyboard counts as a keyboard, and the tap would close it.
--============================================================

local TouchKeeper = {
    Last = -1,
    Pending = false,
    Failures = 0,
}

function TouchKeeper.Check()
    TouchKeeper.Pending = false

    if not Alive
        or not Config.KeepTouchMode
        or not TouchGuard.IsTouchDevice()
        or TouchKeeper.Failures >= 2
        or IsTextBoxFocused()
        or TouchGuard.InTouchMode()
    then
        return
    end

    -- A finger on the screen: wait until it lifts (its own touch may
    -- switch back by itself meanwhile).
    if FingersDown() then
        TouchKeeper.Pending = true
        return
    end

    local Preferred = TouchGuard.Read(UserInputService, "PreferredInput")

    if Preferred ~= nil then
        -- A gamepad is a real choice; only keyboard-and-mouse is undone.
        if Preferred ~= Enum.PreferredInput.KeyboardAndMouse then
            return
        end
    else
        local Last = UserInputService:GetLastInputType()

        if Last ~= Enum.UserInputType.Keyboard
            and not string.find(Last.Name, "Mouse", 1, true)
        then
            return
        end
    end

    if os.clock() - TouchKeeper.Last < 0.3 then
        return
    end

    TouchKeeper.Last = os.clock()

    task.spawn(function()
        RestoreTouchInput()
        task.wait(0.1)

        -- A synthetic touch that does not bring touch mode back (the
        -- executor's touch events count as something else) is never
        -- tried again.
        if not TouchGuard.InTouchMode() and not FingersDown() then
            TouchKeeper.Failures += 1
        end
    end)
end

Connect(UserInputService.TouchEnded, function()
    if TouchKeeper.Pending then
        task.delay(0.05, TouchKeeper.Check)
    end
end)

pcall(function()
    Connect(UserInputService:GetPropertyChangedSignal("PreferredInput"), TouchKeeper.Check)
end)

Connect(UserInputService.LastInputTypeChanged, TouchKeeper.Check)

Connect(UserInputService.TextBoxFocusReleased, function()
    task.delay(0.1, TouchKeeper.Check)
end)

--============================================================
-- NATIVE ACTIONS
--============================================================

local function WaitForMenu(Open, Timeout)
    local Deadline = os.clock() + Timeout

    while Alive and GuiService.MenuIsOpen ~= Open and os.clock() < Deadline do
        task.wait()
    end

    return GuiService.MenuIsOpen == Open
end

-- How the Roblox button reached the menu, kept for this session
-- (re-executing too), so later presses go straight to it.
local MenuMemory = LocalEnv.__OldChrome2024MenuMemory or {}
LocalEnv.__OldChrome2024MenuMemory = MenuMemory

local MenuRoutes = {}

-- No input at all.
function MenuRoutes.SettingsHub(Open)
    local Settings = Native.Settings

    return Settings ~= nil
        and pcall(function()
            Settings:SetVisibility(Open)
        end)
        and WaitForMenu(Open, 0.3)
end

-- No input: the native button's handlers, called directly.
function MenuRoutes.handler(Open)
    local Button = FindNativeMenuButton()

    return Button ~= nil and CallHandlers(Button.Activated) and WaitForMenu(Open, 0.3)
end

-- A synthetic touch: the device stays in touch mode.
function MenuRoutes.tap(Open)
    if not TouchGuard.IsTouchDevice() or MenuMemory.TapMissed then
        return false
    end

    local Sent, Reached = TapNativeMenuButton()

    if Sent and WaitForMenu(Open, Reached and 1 or 0.15) then
        return true
    end

    if Sent then
        MenuMemory.TapMissed = true
        Note("The tap on Roblox's own menu button missed; it is not tried again.")
    end

    return false
end

-- firesignal may click with a fake mouse: touch mode is put back.
function MenuRoutes.firesignal(Open)
    local Button = FindNativeMenuButton()

    if not (Button and SimulateSignal(Button.Activated)) then
        return false
    end

    local Opened = WaitForMenu(Open, 0.3)

    if TouchGuard.IsTouchDevice() and not TouchGuard.InTouchMode() then
        task.spawn(RestoreTouchInput)
    end

    return Opened
end

-- Computers only: on a phone one key event makes Roblox treat it as a
-- computer (keyboard settings, cursor, no thumbstick).
function MenuRoutes.key(Open)
    return not TouchGuard.IsTouchDevice()
        and SendKey(Enum.KeyCode.Escape)
        and WaitForMenu(Open, 0.5)
end

local MENU_ORDER = { "SettingsHub", "handler", "tap", "firesignal", "key" }

-- Opens or closes the Escape menu, preferring paths that do not
-- send input. Yields while it waits for the menu.
local function SetEscapeMenuOpen(Open)
    if GuiService.MenuIsOpen == Open then
        return true
    end

    -- Taken before anything below can hide the touch controls.
    if Open and not TouchGuard.Baseline then
        TouchGuard.Baseline = TouchGuard.Snapshot()
    end

    local Order = table.clone(MENU_ORDER)
    local Known = table.find(Order, MenuMemory.Route)

    -- The route that worked last time goes first, unless a route that
    -- sends no input is available.
    if Known and Known > 2 then
        table.remove(Order, Known)
        table.insert(Order, 3, MenuMemory.Route)
    end

    for _, Name in ipairs(Order) do
        -- A slow toggle from a previous route must not be toggled back.
        if GuiService.MenuIsOpen == Open then
            return true
        end

        if MenuRoutes[Name](Open) then
            MenuMemory.Route = Name
            State.MenuPath = Name
            return true
        end
    end

    State.MenuPath = "none"
    Note("The Escape menu could not be reached.")

    return GuiService.MenuIsOpen == Open
end

-- ChromeUtils.dismissRobloxMenuAndRun: opening a panel first
-- closes the Escape menu.
local function DismissMenu()
    if GuiService.MenuIsOpen then
        SetEscapeMenuOpen(false)
    end
end

-- Each list is tried in order. A step returns true when it made
-- an attempt; the next step only runs if the native state did not
-- follow, which is what makes mobile work when a path is missing.
local Steps = {}

Steps.chat = {
    function(Desired)
        if Desired then
            DismissMenu()
        end

        StarterGui:SetCore("ChatActive", Desired)

        return true
    end,
}

Steps.leaderboard = {
    function(Desired)
        local Controller = Native.PlayerList

        if not Controller then
            return false
        end

        if Desired then
            DismissMenu()
        end

        Controller:SetVisibility(Desired)

        return true
    end,

    function()
        return ActivateChromeIntegration("leaderboard")
    end,

    function(Desired)
        -- The native Tab handler passes on small touch screens.
        if IsSmallTouchScreen() then
            return false
        end

        if Desired then
            DismissMenu()
        end

        return SendKey(Enum.KeyCode.Tab)
    end,

    function()
        return FireNativeHitArea("leaderboard")
    end,
}

Steps.backpack = {
    function(Desired)
        local Module = Native.Backpack
        local OpenClose = Module and rawget(Module, "OpenClose")

        if type(OpenClose) ~= "function" then
            return false
        end

        if Desired then
            DismissMenu()
        end

        if rawget(Module, "IsOpen") ~= Desired then
            OpenClose(Module)
        end

        return true
    end,

    function()
        return ActivateChromeIntegration("backpack")
    end,

    function(Desired)
        if Desired then
            DismissMenu()
        end

        return CallNativeKeyHandler("BackpackScript", Enum.KeyCode.Backquote)
    end,

    function(Desired)
        if Desired then
            DismissMenu()
        end

        return SendKey(Enum.KeyCode.Backquote)
    end,

    function()
        return FireNativeHitArea("backpack")
    end,
}

Steps.emotes = {
    function(Desired)
        if Desired then
            DismissMenu()
        end

        GuiService:SetEmotesMenuOpen(Desired)

        return true
    end,

    function()
        return ActivateChromeIntegration("emotes")
    end,
}

local function WaitForState(Reader, Desired, Timeout)
    local Deadline = os.clock() + Timeout

    while Alive and os.clock() < Deadline do
        local Value = Reader()

        if Value == nil or Value == Desired then
            return Value
        end

        task.wait(0.05)
    end

    return Reader()
end

local function RunAction(Id, Desired)
    local Reader = Readers[Id]

    State.Active[Id] = Desired
    State.LockUntil[Id] = os.clock() + 0.6
    UpdateIconStates()

    task.spawn(function()
        for _, Step in ipairs(Steps[Id] or {}) do
            if not Alive then
                return
            end

            if Reader and Reader() == Desired then
                break
            end

            local Ok, Attempted = pcall(Step, Desired)

            if Ok and Attempted then
                State.LockUntil[Id] = os.clock() + 0.6

                local Result = Reader and WaitForState(Reader, Desired, 0.4)

                if Result == nil or Result == Desired then
                    break
                end
            end
        end

        if Reader and Reader() ~= Desired then
            Log("No native path changed", Id, "to", Desired)
        end

        State.LockUntil[Id] = 0
        SyncNativeState()
    end)
end

local function ToggleIntegration(Id)
    local Reader = Readers[Id]
    local Current = Reader and Reader()

    if Current == nil then
        Current = State.Active[Id]
    end

    RunAction(Id, not Current)
end

--============================================================
-- REPORT (trust_and_safety)
--============================================================
-- 2024: opens SettingsHub on the Report page; pressing it again
-- on that page closes the menu. The icon is "on" while the Report
-- page is the current page.
--============================================================

local function FindReportButton()
    if not RobloxGui then
        return nil
    end

    local Best, BestScore = nil, 0

    for _, Object in ipairs(RobloxGui:GetDescendants()) do
        if Object:IsA("GuiButton") and Object.Visible then
            local Score = 0
            local Name = string.lower(Object.Name)

            if Name == "report" then
                Score += 200
            elseif string.find(Name, "report", 1, true) then
                Score += 100
            end

            for _, Child in ipairs(Object:GetDescendants()) do
                if Child:IsA("TextLabel") or Child:IsA("TextButton") then
                    local Text = string.lower(Child.Text)

                    if Text == "report" then
                        Score += 150
                    elseif string.find(Text, "report", 1, true) then
                        Score += 75
                    end
                end
            end

            if Score > BestScore then
                Best, BestScore = Object, Score
            end
        end
    end

    return Best
end

local function ActivateReport()
    local Settings = Native.Settings

    if Settings then
        task.spawn(function()
            pcall(function()
                local Page = rawget(Settings, "Instance").ReportAbusePage

                if Settings:GetVisibility() then
                    if Native.ReportPageOpen then
                        Settings:SetVisibility(false)
                    else
                        Settings:SwitchToPage(Page, true)
                    end
                else
                    Settings:SetVisibility(true, false, Page)
                end
            end)
        end)

        return
    end

    -- Without SettingsHub: open the Escape menu and press its
    -- Report tab, like the previous build did.
    if State.Active.report then
        State.Active.report = false
        UpdateIconStates()

        task.spawn(SetEscapeMenuOpen, false)

        return
    end

    State.Active.report = true
    UpdateIconStates()

    task.spawn(function()
        SetEscapeMenuOpen(true)

        local Deadline = os.clock() + 5
        local Button

        repeat
            task.wait(0.05)
            Button = GuiService.MenuIsOpen and FindReportButton()
        until Button or os.clock() > Deadline or not Alive

        if Button then
            -- Phones: tap the tab for real, so touch mode is kept, once
            -- a tap has just proved to reach Roblox's buttons.
            local Tapped = (State.MenuPath == "tap" or State.MenuPath == "Roblox's own button")
                and not MenuMemory.TapMissed
                and TapButton(Button, false)

            if not Tapped and not FireSignal(Button.Activated) then
                FireSignal(Button.MouseButton1Click)
            end
        else
            warn("[OLD CHROME] Could not locate the real Roblox Report button.")
        end
    end)
end

--============================================================
-- ESCAPE MENU
--============================================================

local function ToggleEscapeMenu()
    if State.MenuBusy then
        return
    end

    State.MenuBusy = true

    task.spawn(function()
        pcall(SetEscapeMenuOpen, not GuiService.MenuIsOpen)
        Status.MenuPath = State.MenuPath
        State.MenuBusy = false
    end)
end

local function ActivateIntegration(Id)
