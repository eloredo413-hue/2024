--============================================================
-- ROBLOX'S OWN MENU BUTTON, INSIDE OURS
--============================================================
-- Roblox's own (hidden) menu button is moved into the 2024 Roblox
-- icon, invisible and on top of it. A finger on the icon presses the
-- real button, so Roblox opens or closes the menu at once with real
-- touch input: nothing is simulated, and a phone stays in touch mode
-- whatever the executor supports. It goes back on unload.
--============================================================

local REAL_BUTTON_PROPERTIES = {
    "AnchorPoint", "Position", "Size", "ZIndex", "Visible", "Rotation",
    "BackgroundTransparency", "ImageTransparency", "TextTransparency",
}

local function SetIfDifferent(Object, Property, Value)
    pcall(function()
        if Object[Property] ~= Value then
            Object[Property] = Value
        end
    end)
end

-- Clickable, but nothing of it shows: our icon is what is seen.
local function FitRealMenuButton(Button)
    SetIfDifferent(Button, "AnchorPoint", Vector2.new(0, 0))
    SetIfDifferent(Button, "Position", UDim2.fromScale(0, 0))
    SetIfDifferent(Button, "Size", UDim2.fromScale(1, 1))
    SetIfDifferent(Button, "ZIndex", MenuIconBackground.ZIndex + 20)
    SetIfDifferent(Button, "Visible", true)
    SetIfDifferent(Button, "Rotation", 0)
    SetIfDifferent(Button, "BackgroundTransparency", 1)
    SetIfDifferent(Button, "ImageTransparency", 1)
    SetIfDifferent(Button, "TextTransparency", 1)

    for _, Object in ipairs(Button:GetDescendants()) do
        if Object:IsA("GuiObject") then
            SetIfDifferent(Object, "Visible", false)
        end
    end
end

local function ReleaseRealMenuButton(PutBack)
    local Button = RealMenuButton.Button

    RealMenuButton.Button = nil

    for _, Connection in ipairs(RealMenuButton.Watch) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    table.clear(RealMenuButton.Watch)

    -- Destroyed by Roblox: nothing to give back.
    if not (Button and Button.Parent) then
        return
    end

    pcall(function()
        for Object, Visible in pairs(RealMenuButton.Hidden) do
            if Object ~= Button and Object:IsDescendantOf(Button) then
                Object.Visible = Visible
            end
        end

        for Property, Value in pairs(RealMenuButton.Saved) do
            pcall(function()
                Button[Property] = Value
            end)
        end

        if PutBack and Button.Parent == MenuIconBackground then
            Button.Parent = RealMenuButton.Parent
        end
    end)
end

local function AdoptRealMenuButton()
    if not Alive
        or not Config.UseRealMenuButton
        or RealMenuButton.Button
        or not (MenuIconBackground and MenuIconBackground:IsA("GuiButton"))
    then
        return
    end

    local Button = FindNativeMenuButton()

    if not Button then
        return
    end

    -- Only the button whose own handler opens the menu.
    local List = GetConnectionList(Button.Activated)

    if List and #List == 0 then
        return
    end

    local Parent = Button.Parent
    local Saved, Hidden = {}, {}

    for _, Property in ipairs(REAL_BUTTON_PROPERTIES) do
        pcall(function()
            Saved[Property] = Button[Property]
        end)
    end

    for _, Object in ipairs(Button:GetDescendants()) do
        if Object:IsA("GuiObject") then
            Hidden[Object] = Object.Visible
        end
    end

    if not pcall(function()
        Button.Parent = MenuIconBackground
    end) then
        return
    end

    RealMenuButton.Button = Button
    RealMenuButton.Parent = Parent
    RealMenuButton.Saved = Saved
    RealMenuButton.Hidden = Hidden
    FitRealMenuButton(Button)

    local Watch = RealMenuButton.Watch

    local function Refit()
        if RealMenuButton.Button == Button then
            FitRealMenuButton(Button)
        end
    end

    -- Roblox re-renders its button (hover, press): keep it invisible.
    for _, Property in ipairs(REAL_BUTTON_PROPERTIES) do
        pcall(function()
            table.insert(Watch, Button:GetPropertyChangedSignal(Property):Connect(Refit))
        end)
    end

    for Object in pairs(Hidden) do
        table.insert(Watch, Object:GetPropertyChangedSignal("Visible"):Connect(Refit))
    end

    table.insert(Watch, Button.DescendantAdded:Connect(function(Object)
        if Object:IsA("GuiObject") then
            Hidden[Object] = Object.Visible
            table.insert(Watch, Object:GetPropertyChangedSignal("Visible"):Connect(Refit))
            Refit()
        end
    end))

    -- Roblox rebuilt its top bar: take the new button.
    table.insert(Watch, Button:GetPropertyChangedSignal("Parent"):Connect(function()
        if RealMenuButton.Button == Button and Button.Parent ~= MenuIconBackground then
            ReleaseRealMenuButton(false)
            task.delay(0.5, AdoptRealMenuButton)
        end
    end))

    -- Our press highlight follows the real button.
    local Control = BindInteractable(Button, ShowMenuIconState)
    local WasOpen = nil

    table.insert(Watch, Button.InputBegan:Connect(function(Input)
        local Type = Input.UserInputType

        if Type == Enum.UserInputType.Touch or Type == Enum.UserInputType.MouseButton1 then
            WasOpen = GuiService.MenuIsOpen

            -- Taken before the menu can hide the touch controls.
            if not WasOpen and not TouchGuard.Baseline then
                TouchGuard.Baseline = TouchGuard.Snapshot()
            end
        end
    end))

    table.insert(Watch, Button.Activated:Connect(function()
        if not Alive then
            return
        end

        local Was = WasOpen
        local Changes = RealMenuButton.MenuChanges

        WasOpen = nil
        State.LastOwnActivation = os.clock()
        State.MenuPath = "Roblox's own button"
        Status.MenuPath = State.MenuPath
        CloseSubmenu()

        if Control then
            Control.Reset(true)
        end

        -- Roblox's handler toggles the menu at once. If it did not, the
        -- other routes do it.
        task.delay(0.3, function()
            if Alive
                and Was ~= nil
                and RealMenuButton.MenuChanges == Changes
                and GuiService.MenuIsOpen == Was
                and not State.MenuBusy
            then
                State.MenuBusy = true
                pcall(SetEscapeMenuOpen, not Was)
                Status.MenuPath = State.MenuPath
                State.MenuBusy = false
            end
        end)
    end))
end

local function CountMenuChange()
    RealMenuButton.MenuChanges += 1
end

Connect(GuiService.MenuOpened, CountMenuChange)
Connect(GuiService.MenuClosed, CountMenuChange)

do
    local Cleanup = LocalEnv.__OldChrome2024Cleanup

    LocalEnv.__OldChrome2024Cleanup = function()
