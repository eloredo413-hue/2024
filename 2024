--============================================================
-- FIND TOPBARAPP
--============================================================

local function FindTopBarApp()
    if typeof(Project) == "Instance" then
        if Project:IsA("ScreenGui") and Project.Name == "TopBarApp" then
            return Project
        end

        local Found = Project:FindFirstChild("TopBarApp", true)

        if Found then
            return Found
        end
    end

    -- Never fall back to the native TopBarApp that was just disabled.
    for _, Object in ipairs(CoreGui:GetDescendants()) do
        if Object.Name == "TopBarApp"
            and Object:IsA("ScreenGui")
            and not table.find(NativeTopBars, Object)
            and Object:FindFirstChild("UnibarLeftFrame")
        then
            return Object
        end
    end

    return nil
end

local TopBarApp

do
    local StartTime = os.clock()

    repeat
        TopBarApp = FindTopBarApp()

        if not TopBarApp then
            task.wait()
        end
    until TopBarApp or os.clock() - StartTime >= 10
end

assert(TopBarApp, "Chrome2024 TopBarApp could not be found.")

pcall(function()
    TopBarApp:SetAttribute("__OldChrome2024", true)
end)

pcall(function()
    TopBarApp.DisplayOrder = 2147483000
    TopBarApp.Enabled = true
end)

for _, Object in ipairs(NativeTopBars) do
    DisableNativeTopBar(Object)
end

print(
    "[OLD CHROME] Disabled original TopBarApp count:",
    #NativeTopBars
)

TopBarApp.Parent = CoreGui

-- A remounted native top bar (teleport, CoreScript reload) is a new
-- TopBarApp; disable it as soon as it appears.
Connect(CoreGui.DescendantAdded, function(Object)
    pcall(function()
        if Alive
            and Object.Name == "TopBarApp"
            and Object ~= TopBarApp
            and IsNativeTopBar(Object)
        then
            DisableNativeTopBar(Object)
        end
    end)
end)

LocalEnv.__OldChrome2024Cleanup = function()
    DisconnectAll()

    pcall(function()
        TopBarApp:Destroy()
    end)
end

LocalEnv.OldChrome2024Unload = function()
    LocalEnv.__OldChrome2024Cleanup()
    LocalEnv.__OldChrome2024Cleanup = nil

    for _, Object in ipairs(NativeTopBars) do
        pcall(function()
            Object.Enabled = true
        end)
    end
end

