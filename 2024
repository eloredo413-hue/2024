local function ApplyToggleIcon(T)
    local CubeSize = Round(36 * (1 - T))
    local BarWidth = Round(16 * T)

    if ToggleCube then
        ToggleCube.Size = UDim2.fromOffset(CubeSize, CubeSize)
    end

    for _, Bar in ipairs({ ToggleX1 or false, ToggleX2 or false }) do
        if Bar then
            Bar.Size = UDim2.fromOffset(BarWidth, 2)
            Bar.BackgroundTransparency = 1 - T
            Bar.Visible = BarWidth > 0
        end
    end

    if ToggleIcon then
        ToggleIcon.BackgroundColor3 = BACKGROUND_ON_HOVER.Color
        ToggleIcon.BackgroundTransparency =
            1 - (1 - BACKGROUND_ON_HOVER.Transparency) * T
    end
end

--============================================================
-- UNIBAR LAYOUT
--============================================================
-- Unibar.lua (2024, left aligned):
--   * open positions advance by 44 per icon and 5 per divider;
--   * pinned icons (the toggle and user pins) have their own
--     closed positions and are always visible;
--   * other icons start one full width to the left and slide in,
--     hidden while their x is under half a cell.
--============================================================

local function IsInBar(CellId)
    if not Cells[CellId] then
        return false
    end

    local Id = CellIntegration[CellId]

    if Id and RecentCapable[Id] then
        if not State.Available[Id] then
            return false
        end

        return State.Pinned[Id] == true
            or table.find(State.Recent, Id) ~= nil
    end

    return true
end

local function IsPinnedCell(CellId)
    if CellId == "chrome_toggle" then
        return true
    end

    local Id = CellIntegration[CellId]

    return Id ~= nil and State.Pinned[Id] == true
end

local function ComputeLayout()
    local Open = {}
    local ClosedPinned = {}
    local X = 0
    local XPinned = 0

    for _, CellId in ipairs(DisplayOrder) do
        if IsInBar(CellId) then
            Open[CellId] = X

            if IsPinnedCell(CellId) then
                ClosedPinned[CellId] = XPinned
                XPinned += ICON_CELL_WIDTH
            end

            if CellId == "DIV1" then
                X += DIVIDER_CELL_WIDTH
            else
                X += ICON_CELL_WIDTH
            end
        end
    end

    -- Icons that stay in the bar glide from where they are now.
    local R = ReflowValue.Value
    local Prior = {}

    for CellId, OpenX in pairs(Layout.Open) do
        local From = Layout.Prior[CellId]
        Prior[CellId] = From and Lerp(From, OpenX, R) or OpenX
    end

    Layout.PriorFull = Lerp(Layout.PriorFull, Layout.Full, R)
    Layout.Prior = Prior
    Layout.Open = Open
    Layout.ClosedPinned = ClosedPinned
    Layout.Full = X
    Layout.Min = math.max(XPinned, ICON_CELL_WIDTH)
end

local function SetCellVisible(Cell, Visible)
    if Cell.Visible == Visible then
        return
    end

    Cell.Visible = Visible
    Cell.Root.Visible = Visible

    -- A hidden button never receives MouseLeave.
    if not Visible and Cell.Control then
        Cell.Control.Reset(false)
    end

    UpdateCellHighlight(Cell)
end

ApplyUnibar = function()
    local T = ToggleValue.Value
    local R = ReflowValue.Value
    local Full = Lerp(Layout.PriorFull, Layout.Full, R)

    for CellId, Cell in pairs(Cells) do
        local OpenX = Layout.Open[CellId]

        if OpenX == nil then
            SetCellVisible(Cell, false)
        else
            local From = Layout.Prior[CellId]
            local OpenNow = From and Lerp(From, OpenX, R) or OpenX
            local Closed = Layout.ClosedPinned[CellId]
            local Pinned = Closed ~= nil

            if not Pinned then
                Closed = OpenX + ICON_CELL_WIDTH - Full
            end

            local X = Lerp(Closed, OpenNow, T)

            Cell.Root.Position = UDim2.fromOffset(Round(X), 0)

            SetCellVisible(Cell, Pinned or X >= ICON_CELL_WIDTH * 0.5)
        end
    end

    local Width = Round(Lerp(Layout.Min, Full, T))

    Frame2.Size = UDim2.fromOffset(Width, ICON_CELL_WIDTH)

    if UnibarHealthFill then
        UnibarHealthFill.Size = Frame2.Size
    end

    if StackedElements then
        StackedElements.Position = UDim2.fromOffset(Layout.Min, 0)
    end

    ApplyToggleIcon(T)
end

RelayoutUnibar = function()
    ComputeLayout()

    if State.ChromeOpen then
        ReflowValue.Value = 0
        AnimateValue(ReflowValue, 1, MENU_TWEEN)
    else
        AnimateValue(ReflowValue, 1, nil)
    end

    ApplyUnibar()
    ApplyHealth()
end

local function SetChromeOpen(Open)
    if State.ChromeOpen == Open then
        return
    end

    State.ChromeOpen = Open

    -- ChromeService:toggleOpen closes any submenu.
    if not Open then
        CloseSubmenu()
    end

    AnimateValue(ToggleValue, Open and 1 or 0, MENU_TWEEN)
    ApplyHealth()
end

Connect(ToggleValue.Changed, ApplyUnibar)
Connect(ReflowValue.Changed, ApplyUnibar)

