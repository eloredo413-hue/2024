ApplySubmenu = function()
    local T = SubmenuValue.Value
    local Shown = State.SubMenuOpen or T > 0.001

    SubMenuHost.Visible = Shown

    if NineDotMenu then
        NineDotMenu.BackgroundTransparency =
            SUBMENU_TRANSPARENCY + (1 - SUBMENU_TRANSPARENCY) * (1 - T)
    end

    for _, Row in pairs(Rows) do
        if Row.Label then
            Row.Label.TextTransparency = 1 - T
        end

        if Row.Icon then
            Row.Icon.ImageTransparency = 1 - T
        end

        local Base = Row.PinDisabled and UI_EMPHASIS_TRANSPARENCY or 0
        Row.PinIcon.ImageTransparency = Base + (1 - Base) * (1 - T)

        -- A fading-out menu must not take clicks.
        SetProperty(Row.Root, "Interactable", State.SubMenuOpen)
        SetProperty(Row.PinTarget, "Interactable", State.SubMenuOpen)
    end

    if SubmenuSizeConstraint then
        SubmenuSizeConstraint.MaxSize = Vector2.new(
            math.huge,
            Round(State.SubmenuTarget * T)
        )
    end
end

local function OpenSubmenu()
    if State.SubMenuOpen then
        return
    end

    State.SubMenuOpen = true

    RefreshRowAvailability()
    RefreshPins()
    UpdateIconStates()

    SetProperty(ScrollingFrame, "CanvasPosition", Vector2.zero)

    AnimateValue(SubmenuValue, 1, MENU_TWEEN)
    ApplySubmenu()
    UpdateCellHighlight(Cells.nine_dot)
end

CloseSubmenu = function()
    if not State.SubMenuOpen then
        return
    end

    State.SubMenuOpen = false

    for _, Row in pairs(Rows) do
        Row.Control.Reset(false)
        Row.PinControl.Reset(false)
    end

    AnimateValue(SubmenuValue, 0, MENU_TWEEN)
    ApplySubmenu()
    UpdateCellHighlight(Cells.nine_dot)
end

local function ToggleSubmenu()
    if State.SubMenuOpen then
