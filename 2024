local function PredictToggle(Id)
    -- Only needed when the native state cannot be read.
    if Readers[Id]() == nil then
        State.Active[Id] = not State.Active[Id]
        State.LockUntil[Id] = os.clock() + 0.6
        UpdateIconStates()
    end
end

Connect(UserInputService.InputBegan, function(Input)
    if Input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    local Key = Input.KeyCode

    if os.clock() < (SyntheticKeyUntil[Key] or 0) then
        return
    end

    if IsTextBoxFocused() then
        return
    end

    if Key == Enum.KeyCode.Tab then
        if not GuiService.MenuIsOpen and not IsSmallTouchScreen() then
            PredictToggle("leaderboard")
        end
    elseif Key == Enum.KeyCode.Backquote then
        if not GuiService.MenuIsOpen then
            PredictToggle("backpack")
        end
    elseif Key == Enum.KeyCode.Slash then
        -- "/" opens chat; make ChatActive agree with it.
        task.defer(function()
            if Readers.chat() == false then
                pcall(function()
                    StarterGui:SetCore("ChatActive", true)
                end)
            end

            SyncNativeState()
        end)
    elseif Key ~= Enum.KeyCode.Period and Key ~= Enum.KeyCode.Escape then
        return
    end

    SyncSoon()
end)

