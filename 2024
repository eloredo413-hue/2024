local function SyncAvailability()
    local Changed = false

    for Id, Definition in pairs(Integrations) do
        if Definition.CoreGui then
            local Ok, Enabled = pcall(function()
                return StarterGui:GetCoreGuiEnabled(Definition.CoreGui)
            end)

            local Available = Config.ForceEnableCoreGui
                or not Ok
                or Enabled == true

            if State.Available[Id] ~= Available then
                State.Available[Id] = Available
                Changed = true
            end
        end
    end

    if Changed then
        RelayoutUnibar()
        RefreshRowAvailability()
    end
end

SyncNativeState = function()
    if not Alive then
        return
    end

    local Changed = false
    local Now = os.clock()

    for Id, Reader in pairs(Readers) do
        if Now >= (State.LockUntil[Id] or 0) then
            local Value = Reader()

            if Value ~= nil and Value ~= State.Active[Id] then
                State.Active[Id] = Value
                Changed = true
            end
        end
    end

    if Changed then
        UpdateIconStates()
    end

    SyncAvailability()
    ApplyHealth()
end

local function SyncSoon()
    task.defer(SyncNativeState)
    task.delay(0.15, SyncNativeState)
end

