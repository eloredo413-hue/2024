-- MenuRow with pin integrations (2024): the row content moves
-- into "RowLabel" so the pin sits on the right edge, outside the
-- row's list layout.
local function PrepareRow(Id, Root)
    local Definition = Integrations[Id]

    local RowLabel = Instance.new("Frame")
    RowLabel.Name = "RowLabel"
    RowLabel.BackgroundTransparency = 1
    RowLabel.BorderSizePixel = 0
    RowLabel.Size = UDim2.fromScale(1, 1)

    for _, Child in ipairs(Root:GetChildren()) do
        if Child:IsA("UIListLayout")
            or Child:IsA("UIPadding")
            or Child.Name == "IconHost"
            or Child.Name == "StyledTextLabel"
        then
            Child.Parent = RowLabel
        end
    end

    RowLabel.Parent = Root

    SetProperty(RowLabel:FindFirstChildOfClass("UIPadding"), "PaddingLeft", UDim.new(0, 12))

    local IconHost = RowLabel:FindFirstChild("IconHost")

    SetProperty(Path(IconHost, "Highlighter"), "Visible", false)
    SetProperty(Path(IconHost, "SelectedHighlighter"), "Visible", false)

    -- The RBXM labels are TextScaled inside fixed boxes (chat's is
    -- 48 px), which shrank cloned labels like "Report". Size every
    -- label to its text at the 2024 Header2 size instead.
    local Label = RowLabel:FindFirstChild("StyledTextLabel")

    if Label then
        pcall(function()
            Label.Text = Definition.Label
            Label.TextScaled = false
            Label.TextWrapped = false
            Label.TextSize = 20
            Label.TextTruncate = Enum.TextTruncate.AtEnd
            Label.AutomaticSize = Enum.AutomaticSize.X
            Label.Size = UDim2.fromOffset(0, 22)
        end)

        local Limit = Instance.new("UISizeConstraint")
        Limit.MaxSize = Vector2.new(
            240 - 12 - ICON_CELL_WIDTH - 8 - PIN_BUTTON_SIZE - PIN_RIGHT_PADDING - 4,
            22
        )
        Limit.Parent = Label
    end

    SetProperty(Root, "LayoutOrder", Definition.Order)
    SetProperty(Root, "BackgroundTransparency", 1)

    -- UserPin: 40 px rounded button, 13 px from the right edge.
    local Pin = Instance.new("Frame")
    Pin.Name = "UserPin"
    Pin.AnchorPoint = Vector2.new(0, 0.5)
    Pin.Position = UDim2.new(1, -PIN_BUTTON_SIZE - PIN_RIGHT_PADDING, 0.5, 0)
    Pin.Size = UDim2.fromOffset(PIN_BUTTON_SIZE, PIN_BUTTON_SIZE)
    Pin.BackgroundColor3 = BACKGROUND_ON_HOVER.Color
    Pin.BackgroundTransparency = 1
    Pin.BorderSizePixel = 0
    Pin.ZIndex = 2
    Pin.Parent = Root

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Pin

    local PinIcon = Instance.new("ImageLabel")
    PinIcon.Name = "UserPinIcon"
    PinIcon.AnchorPoint = Vector2.new(0.5, 0.5)
    PinIcon.Position = UDim2.fromScale(0.5, 0.5)
    PinIcon.Size = UDim2.fromOffset(PIN_ICON_SIZE, PIN_ICON_SIZE)
    PinIcon.BackgroundTransparency = 1
    PinIcon.Image = PIN_OFF_ASSET
    PinIcon.ZIndex = 3
    PinIcon.Parent = Pin

    -- PinTouchTarget (2024 NewSubmenuTouchTargets): the whole
    -- right end of the row toggles the pin, which matters on touch.
    local PinTarget = Instance.new("ImageButton")
    PinTarget.Name = "PinTouchTarget"
    PinTarget.BackgroundTransparency = 1
    PinTarget.Image = ""
    PinTarget.AutoButtonColor = false
    PinTarget.Position = UDim2.fromOffset(
        1 - PIN_RIGHT_PADDING,
        -(SUB_MENU_ROW_HEIGHT - PIN_BUTTON_SIZE) / 2
    )
    PinTarget.Size = UDim2.fromOffset(
        PIN_BUTTON_SIZE + PIN_RIGHT_PADDING * 2,
        SUB_MENU_ROW_HEIGHT
    )
    PinTarget.ZIndex = 4
    PinTarget.Parent = Pin

    local Row = {
        Id = Id,
        Root = Root,
        Label = Label,
        Icon = Path(IconHost, "IntegrationIconFrame", "IntegrationIcon"),
        Pin = Pin,
        PinIcon = PinIcon,
        PinTarget = PinTarget,
        PinDisabled = false,
    }

    Row.Control = BindInteractable(Root, function()
        SetRowVisual(Row)
    end)

    Row.PinControl = BindInteractable(PinTarget, function()
        SetPinVisual(Row)
    end)

    Rows[Id] = Row

    return Row
end

for Id in pairs(Integrations) do
    local Root = ScrollingFrame:FindFirstChild(Id)

    if Root then
        PrepareRow(Id, Root)
    end
end

RefreshPins = function()
    local Full = PinsFull()

    for Id, Row in pairs(Rows) do
        local Pinned = State.Pinned[Id] == true

        Row.PinDisabled = RecentCapable[Id] == true and Full and not Pinned
        Row.PinControl.Disabled = Row.PinDisabled
        Row.PinControl.Emit()

        SetProperty(Row.PinTarget, "Active", not Row.PinDisabled)
        SetProperty(Row.PinIcon, "Image", Pinned and PIN_ON_ASSET or PIN_OFF_ASSET)
    end

    ApplySubmenu()
end

local function RefreshRowAvailability()
    local Count = 0

    for Id, Row in pairs(Rows) do
        local Available = State.Available[Id] ~= false

        Row.Root.Visible = Available

        if Available then
            Count += 1
        end
    end

    -- SubMenu.lua truncation fix: fit the screen, and when it does
    -- not fit, cut the last row in half as a scroll affordance.
    local Canvas = Count * SUB_MENU_ROW_HEIGHT
    local Space = GetViewportSize().Y - SUBMENU_TOP_BUFFER
    local Target = Canvas

    if Space < Canvas then
        local Fit = math.floor(Space / SUB_MENU_ROW_HEIGHT)
        local Half = SUB_MENU_ROW_HEIGHT * 0.5

        if SUB_MENU_ROW_HEIGHT * Fit + Half <= Space then
            Target = SUB_MENU_ROW_HEIGHT * Fit + Half
        else
            Target = SUB_MENU_ROW_HEIGHT * Fit - Half
        end

        Target = math.max(Target, Half)
    end

    State.SubmenuTarget = Target
    ApplySubmenu()
end

