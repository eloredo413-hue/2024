-- Screen position of a ScreenGui's origin: the GUI inset, unless it
-- ignores it (both top bars do).
local function GuiOrigin(Gui)
    local Ok, Ignore = pcall(function()
        return Gui.IgnoreGuiInset
    end)

    if Ok and Ignore == false then
        local InsetOk, Inset = pcall(function()
            return GuiService:GetGuiInset()
        end)

        if InsetOk and typeof(Inset) == "Vector2" then
            return Inset
        end
    end

    return Vector2.new(0, 0)
end

function TapGuard.Show(Position, Size)
    local Left, Top = Position.X, Position.Y
    local Right, Bottom = Left + Size.X, Top + Size.Y
    local Parts = TapGuard.Parts

    Parts.Top.Position = UDim2.fromOffset(-200, -200)
    Parts.Top.Size = UDim2.new(1, 400, 0, Top + 200)
    Parts.Bottom.Position = UDim2.fromOffset(-200, Bottom)
    Parts.Bottom.Size = UDim2.new(1, 400, 1, 200 - Bottom)
    Parts.Left.Position = UDim2.fromOffset(-200, Top)
    Parts.Left.Size = UDim2.fromOffset(Left + 200, Size.Y)
    Parts.Right.Position = UDim2.fromOffset(Right, Top)
    Parts.Right.Size = UDim2.new(1, 200 - Right, 0, Size.Y)
    TapGuard.Frame.Visible = true
end

local TOUCH_TAP_ID = 9138

-- Taps a CoreScript button with a synthetic touch. The CoreScript
-- then handles it exactly like a real tap, and the device stays in
-- touch mode (a handler called from here, or a firesignal that
-- clicks, guarantees neither). Everything but the button is covered
-- meanwhile. EnableGui: the button is in the disabled native top bar,
-- which is enabled for those two frames.
local function TapButton(Button, EnableGui)
    local NativeGui = Button and Button:FindFirstAncestorWhichIsA("LayerCollector")
    local Deadline = os.clock() + 0.25

    -- A restore tap may be finishing, and the finger that tapped our
    -- button may take a frame to be reported as lifted.
    while (State.SyntheticTouch or FingersDown()) and os.clock() < Deadline do
        task.wait()
    end

    -- Another finger is holding something (thumbstick, jump button):
    -- covering the screen now could leave it stuck.
    if not (VirtualInputManager and NativeGui and MenuIconBackground)
        or State.SyntheticTouch
        or State.NoTouchEvents
        or FingersDown()
    then
        return false
    end

    State.SyntheticTouch = true
    NativeBarHold.Open = EnableGui == true

    local Sent = false
    local Reached = false

    -- Known within a few frames, so a miss costs a moment, not a second.
    local Watch = nil

    pcall(function()
        Watch = Button.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.Touch then
                Reached = true
            end
        end)
    end)

    pcall(function()
        local Position, Size = Button.AbsolutePosition, Button.AbsoluteSize

        if EnableGui then
            NativeGui.Enabled = true
        end

        if Size.X < 8 or Size.Y < 8 then
            -- Never laid out while it was disabled.
            task.wait()
            Position, Size = Button.AbsolutePosition, Button.AbsoluteSize
        end

        if Size.X < 8 or Size.Y < 8 then
            return
        end

        local Screen = Position + GuiOrigin(NativeGui)
        local Center = Screen + Size / 2

        TapGuard.Show(Screen - GuiOrigin(TopBarApp), Size)
        TapGuard.Backstop.DisplayOrder = NativeGui.DisplayOrder - 1
        TapGuard.Backstop.Enabled = true
        -- Ours would catch the touch, unless the target sits inside it.
        if not Button:IsDescendantOf(MenuIconBackground) then
            SetProperty(MenuIconBackground, "Interactable", false)
        end

        State.LastOwnActivation = os.clock()

        Sent = pcall(function()
            VirtualInputManager:SendTouchEvent(TOUCH_TAP_ID, Enum.UserInputState.Begin.Value, Center.X, Center.Y)
            task.wait()
            VirtualInputManager:SendTouchEvent(TOUCH_TAP_ID, Enum.UserInputState.End.Value, Center.X, Center.Y)
        end)

        -- The executor has no touch events; never try again.
        State.NoTouchEvents = not Sent

        task.wait()
    end)

    if Watch then
        Watch:Disconnect()
    end

    TapGuard.Frame.Visible = false
    TapGuard.Backstop.Enabled = false
    SetProperty(MenuIconBackground, "Interactable", true)

    if EnableGui then
        pcall(function()
            NativeGui.Enabled = false
        end)
    end

    NativeBarHold.Open = false
    State.SyntheticTouch = false

    return Sent, Reached or GuiService.MenuIsOpen
end

local function TapNativeMenuButton()
    -- Inside our icon it is already on screen.
    if RealMenuButton.Button then
        return TapButton(RealMenuButton.Button, false)
    end

    return TapButton(FindNativeMenuButton(), true)
end

-- "2 of 2" when every handler of the native Roblox button can be
-- called directly, "0 of 2" when the executor hides them.
local function DescribeMenuHandlers()
    local Button = FindNativeMenuButton()
    local List = Button and GetConnectionList(Button.Activated)

    if not List then
        return "unknown"
    end

    local Callable = 0

    for _, Item in ipairs(List) do
        if GetHandler(Item) then
            Callable += 1
        end
    end

    return string.format("%d of %d", Callable, #List)
end

-- Calls a CoreScript's own UserInputService.InputBegan handler with a
-- key, instead of sending a real key event. Nothing reaches the input
-- system, so PreferredInput (and the touch controls) stay as they are.
local function CallNativeKeyHandler(SourceName, KeyCode)
    if type(getconnections) ~= "function" then
        return false
    end

    local Ok, List = pcall(getconnections, UserInputService.InputBegan)

    if not Ok or type(List) ~= "table" then
        return false
    end

    for _, Item in ipairs(List) do
        local Handler = nil

        pcall(function()
            Handler = Item.Function
        end)

        local SourceOk, Source = false, nil

        if type(Handler) == "function" then
            SourceOk, Source = pcall(debug.info, Handler, "s")
        end

        if SourceOk
            and type(Source) == "string"
            and string.find(Source, SourceName, 1, true)
        then
            local Input = {
                UserInputType = Enum.UserInputType.Keyboard,
                UserInputState = Enum.UserInputState.Begin,
                KeyCode = KeyCode,
            }

            -- isProcessed = true: only the hotkey runs, not the
            -- "a tap closes the inventory" branch.
            task.spawn(function()
                pcall(Handler, Input, true)
            end)

            return true
        end
    end

    return false
end

-- RobloxGui.Backpack.Inventory is the real open/closed frame. The
-- root "Backpack" frame is the always-visible hotbar container;
-- hiding that one is what used to make the hotbar vanish on mobile.
local function FindInventoryFrame()
    local Backpack = RobloxGui and RobloxGui:FindFirstChild("Backpack")
    local Inventory = Backpack and Backpack:FindFirstChild("Inventory")

    if Inventory and Inventory:IsA("GuiObject") then
        return Inventory
    end

    return nil
end

-- The PlayerList app's root frame (the parent of "OffsetFrame")
-- carries its visibility: RobloxGui.PlayerListMaster in 2024,
-- CoreGui.PlayerList on later clients.
local function FindPlayerListFrame()
    -- Not ipairs over a literal: a missing first root is nil and
    -- would end the loop before the second one is checked.
    local Roots = {
        RobloxGui and RobloxGui:FindFirstChild("PlayerListMaster") or false,
        CoreGui:FindFirstChild("PlayerList") or false,
    }

    for _, Root in ipairs(Roots) do
        local Offset = Root and Root:FindFirstChild("OffsetFrame", true)
        local Frame = Offset and Offset.Parent

        if Frame and Frame:IsA("GuiObject") then
            return Frame
        end
    end

    return nil
end

