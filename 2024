--============================================================
-- NATIVE MODULE SCAN / SOFT CLOSE
--============================================================

local function ClosePanelsOnStart()
    for _, Id in ipairs({ "chat", "leaderboard", "backpack", "emotes" }) do
        -- Only close what is known to be open: toggling a panel whose
        -- state cannot be read could open it instead.
        if Readers[Id]() == true and State.Available[Id] then
            RunAction(Id, false)
        end
    end
end

task.spawn(function()
    local Scanned = ScanNativeModules()

    if not Alive then
        return
    end

    HookNativeModules()
    SyncNativeState()

    print(string.format(
        "[OLD CHROME] Native: getgc=%s | PlayerList=%s | Backpack=%s | SettingsHub=%s | Chrome=%s",
        Scanned and "yes" or "no",
        Native.PlayerList and "found" or "fallback",
        Native.Backpack and "found" or "fallback",
        Native.Settings and "found" or "fallback",
        Native.Chrome and "found" or "fallback"
    ))

    if Config.ClosePanelsOnStart then
        ClosePanelsOnStart()
    end
end)

