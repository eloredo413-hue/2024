--============================================================
-- UTILITY
--============================================================

local function Lerp(A, B, T)
    return A + (B - A) * T
end

local function Round(Value)
    return math.floor(Value + 0.5)
end

local function SetProperty(Object, Property, Value)
    if Object then
        pcall(function()
            Object[Property] = Value
        end)
    end
end

local function ApplySprite(Image, Sprite)
    if not Image or not Sprite then
        return
    end

    local RectSize = Sprite[4] or 36

    pcall(function()
        Image.Image = Sprite[1]
        Image.ImageRectOffset = Vector2.new(Sprite[2], Sprite[3])
        Image.ImageRectSize = Vector2.new(RectSize, RectSize)
    end)
end

local function IsTextBoxFocused()
    local Ok, Box = pcall(function()
        return UserInputService:GetFocusedTextBox()
    end)

    return Ok and Box ~= nil
end

local function GetViewportSize()
    local Camera = Workspace.CurrentCamera

    if Camera then
        return Camera.ViewportSize
    end

    return Vector2.new(1280, 720)
end

local function IsMobileDevice()
    local Ok, Platform = pcall(function()
        return UserInputService:GetPlatform()
    end)

    if Ok and Platform then
        return Platform == Enum.Platform.IOS
            or Platform == Enum.Platform.Android
    end

    if not UserInputService.TouchEnabled then
        return false
    end

    -- GetPlatform needs RobloxScript capability. Without it: phones and
    -- tablets have motion sensors. KeyboardEnabled / MouseEnabled can't
    -- be trusted here: a fake key or click can leave them true on a phone.
    local SensorOk, HasSensor = pcall(function()
        return UserInputService.AccelerometerEnabled or UserInputService.GyroscopeEnabled
    end)

    if SensorOk and HasSensor then
        return true
    end

    return not UserInputService.KeyboardEnabled
        and not UserInputService.MouseEnabled
end

-- Clone of ViewportUtil.isSmallTouchScreen (2024).
local function IsSmallTouchScreen()
    local Size = GetViewportSize()

    return UserInputService.TouchEnabled
        and (Size.Y < 500 or Size.X < 700)
end

-- ChromeService:updateScreenSize (2024).
local function ComputeSlotLimit()
    if not IsMobileDevice() then
        return 4
    end

    local Size = GetViewportSize()
    local Portrait = Size.Y > Size.X

    if Portrait and Size.X < 360 then
        return 0
    elseif Portrait then
        return 1
    end

    return 2
end

-- The PlayerModule (ControlModule:UpdateTouchGuiVisibility) only
-- shows the thumbstick and jump button while PreferredInput is Touch.
-- One synthetic key event switches PreferredInput to KeyboardAndMouse:
-- the touch controls disappear and a mouse cursor shows until the next
-- real touch. Native hotkeys are therefore only ever emulated for a
-- player who is actually on keyboard and mouse.
local function IsKeyboardAndMouse()
    -- Phones and tablets never count, whatever PreferredInput currently
    -- says: it may already have been flipped by an earlier fake key or
    -- by an executor overlay.
    if IsMobileDevice()
        or (UserInputService.TouchEnabled and not UserInputService.MouseEnabled)
    then
        return false
    end

    local Ok, Result = pcall(function()
        return UserInputService.PreferredInput == Enum.PreferredInput.KeyboardAndMouse
    end)

    if Ok then
        return Result
    end

    -- Clients without PreferredInput.
    if not UserInputService.TouchEnabled then
        return true
    end

    return UserInputService.KeyboardEnabled
        and UserInputService:GetLastInputType() ~= Enum.UserInputType.Touch
end

local function MouseHoverAllowed()
    return UserInputService.MouseEnabled and IsKeyboardAndMouse()
end

