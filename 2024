-- Runs a signal's connected handlers. Calling each handler directly is
-- preferred: a plain Lua call cannot generate input, while how an
-- executor implements firesignal / :Fire() is unknown.
local function FireSignal(Signal)
    local List = nil

    if type(getconnections) == "function" then
        local Ok, Result = pcall(getconnections, Signal)

        if Ok and type(Result) == "table" then
            List = Result
        end
    end

    if List then
        local Called = false

        for _, Item in ipairs(List) do
            local Handler = nil

            pcall(function()
                Handler = Item.Function
            end)

            if type(Handler) == "function" then
                Called = true

                task.spawn(function()
                    pcall(Handler)
                end)
            end
        end

        if Called then
            return true
        end
    end

    if type(firesignal) == "function" and pcall(firesignal, Signal) then
        return true
    end

    if List and #List > 0 then
        for _, Item in ipairs(List) do
            pcall(function()
                Item:Fire()
            end)
        end

        return true
    end

    return false
end

-- Invisible, full-screen and above everything (our ScreenGui has the
-- highest DisplayOrder). Shown for a couple of frames so a synthetic
-- tap lands on it and nowhere else, whatever its exact coordinates.
local TouchSink = Instance.new("ImageButton")
TouchSink.Name = "__OldChrome2024TouchSink"
TouchSink.BackgroundTransparency = 1
TouchSink.ImageTransparency = 1
TouchSink.AutoButtonColor = false
TouchSink.Active = true
TouchSink.Visible = false
TouchSink.Position = UDim2.fromOffset(-200, -200)
TouchSink.Size = UDim2.new(1, 400, 1, 400)
TouchSink.ZIndex = 100000
TouchSink.Parent = TopBarApp

local TOUCH_SINK_ID = 9137

-- A synthetic key switches a touch device to keyboard-and-mouse mode:
-- a cursor appears and the thumbstick / jump button hide. One
-- synthetic tap on the sink switches it straight back to touch.
local function RestoreTouchInput()
    if not VirtualInputManager or not UserInputService.TouchEnabled then
        return
    end

    local Size = GetViewportSize()
    local X, Y = Size.X / 2, Size.Y / 2

    State.LastOwnActivation = os.clock()
    TouchSink.Visible = true

    pcall(function()
        VirtualInputManager:SendTouchEvent(TOUCH_SINK_ID, Enum.UserInputState.Begin.Value, X, Y)
        task.wait()
        VirtualInputManager:SendTouchEvent(TOUCH_SINK_ID, Enum.UserInputState.End.Value, X, Y)
    end)

    task.wait()
    TouchSink.Visible = false
end

-- Native paths are always tried first. Without AllowOnTouch, touch
-- devices never get synthetic keys; with it (the Escape menu, which
-- has no other way in on some executors) touch mode is restored
-- right after the key.
local function SendKey(KeyCode, AllowOnTouch)
    if not VirtualInputManager then
        return false
    end

    local OnTouch = not IsKeyboardAndMouse()

    if OnTouch and not AllowOnTouch then
        return false
    end

    -- Our own InputBegan handler must not treat this as a user press.
    SyntheticKeyUntil[KeyCode] = os.clock() + 0.35

    local Ok = pcall(function()
        VirtualInputManager:SendKeyEvent(true, KeyCode, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, KeyCode, false, game)
    end)

    if OnTouch then
        task.wait()
        RestoreTouchInput()
    end

    return Ok
end

local function MetaIndex(Table)
    local GetMeta = getrawmetatable or getmetatable
    local Ok, Meta = pcall(GetMeta, Table)

    if Ok and type(Meta) == "table" then
        local Index = rawget(Meta, "__index")

        if type(Index) == "table" then
            return Index
        end
    end

    return nil
end

-- Identifies the CoreScript singletons by their exact shape.
-- Only rawget is used so strict metatables can never error.
local function ClassifyNative(Value)
    local ModuleName = rawget(Value, "ModuleName")

    if ModuleName == "SettingsMenu" then
        if type(rawget(Value, "SetVisibility")) == "function"
            and type(rawget(Value, "Instance")) == "table"
        then
            Native.Settings = Value
        end
    elseif ModuleName == "Backpack" then
        if typeof(rawget(Value, "StateChanged")) == "Instance" then
            Native.Backpack = Value
        end
    elseif typeof(rawget(Value, "SetVisibleChangedEvent")) == "Instance" then
        local Index = MetaIndex(Value)

        if Index
            and type(rawget(Index, "SetVisibility")) == "function"
            and type(rawget(Index, "GetSetVisible")) == "function"
        then
            Native.PlayerList = Value
        end
    elseif type(rawget(Value, "_integrations")) == "table"
        and type(rawget(Value, "_subMenuConfig")) == "table"
    then
        Native.Chrome = Value
    end
end

local function ScanNativeModules()
    if type(getgc) ~= "function" then
        return false
    end

    local Ok, Objects = pcall(getgc, true)

    if not Ok or type(Objects) ~= "table" then
        return false
    end

    local Count = 0

    for _, Value in pairs(Objects) do
        if type(Value) == "table" then
            pcall(ClassifyNative, Value)
        end

        Count += 1

        -- Spread the scan over frames instead of one long hitch.
        if Count % 25000 == 0 then
            task.wait()
        end
    end

    return true
end

local function ActivateChromeIntegration(Id)
    local Chrome = Native.Chrome
    local List = Chrome and rawget(Chrome, "_integrations")
    local Integration = type(List) == "table" and rawget(List, Id)
    local Activated = type(Integration) == "table" and rawget(Integration, "activated")

    if type(Activated) ~= "function" then
        return false
    end

    task.spawn(function()
        pcall(Activated, Integration)
    end)

    return true
end

-- Last resort: the disabled native unibar still has its buttons.
local function FireNativeHitArea(Id)
    for _, Object in ipairs(NativeTopBars) do
        local Button = Object:FindFirstChild("IconHitArea_" .. Id, true)

        if Button and Button:IsA("GuiButton") then
            return FireSignal(Button.Activated)
        end
    end

    return false
end

-- The disabled native top bar's own Roblox button
-- (MenuIconHolder / MenuIcon > MenuIconTriggerPoint). Its handler
-- is SettingsHub:ToggleVisibility, so firing it needs no key event.
local function FireNativeMenuButton()
    for _, Object in ipairs(NativeTopBars) do
        for _, Name in ipairs({ "MenuIconHolder", "MenuIcon", "MenuIconTriggerPoint" }) do
            local Holder = Object:FindFirstChild(Name, true)
            local Button = Holder
                and (Holder:IsA("GuiButton") and Holder
                    or Holder:FindFirstChildWhichIsA("GuiButton", true))

            if Button then
                return FireSignal(Button.Activated)
            end
        end
    end

    return false
end

-- Calls a CoreScript's own UserInputService.InputBegan handler with a
-- key, instead of sending a real key event. Nothing reaches the input
-- system, so PreferredInput (and the touch controls) stay as they are.
local function CallNativeKeyHandler(SourceName, KeyCode)
    if type(getconnections) ~= "function" then
        return false
    end

    local Ok, List = pcall(getconnections, UserInputService.InputBegan)

    if not Ok or type(List) ~= "table" then
        return false
    end

    for _, Item in ipairs(List) do
        local Handler = nil

        pcall(function()
            Handler = Item.Function
        end)

        local SourceOk, Source = false, nil

        if type(Handler) == "function" then
            SourceOk, Source = pcall(debug.info, Handler, "s")
        end

        if SourceOk
            and type(Source) == "string"
            and string.find(Source, SourceName, 1, true)
        then
            local Input = {
                UserInputType = Enum.UserInputType.Keyboard,
                UserInputState = Enum.UserInputState.Begin,
                KeyCode = KeyCode,
            }

            -- isProcessed = true: only the hotkey runs, not the
            -- "a tap closes the inventory" branch.
            task.spawn(function()
                pcall(Handler, Input, true)
            end)

            return true
        end
    end

    return false
end

-- RobloxGui.Backpack.Inventory is the real open/closed frame. The
-- root "Backpack" frame is the always-visible hotbar container;
-- hiding that one is what used to make the hotbar vanish on mobile.
local function FindInventoryFrame()
    local Backpack = RobloxGui and RobloxGui:FindFirstChild("Backpack")
    local Inventory = Backpack and Backpack:FindFirstChild("Inventory")

    if Inventory and Inventory:IsA("GuiObject") then
        return Inventory
    end

    return nil
end

-- The PlayerList app's root frame (the parent of "OffsetFrame")
-- carries its visibility: RobloxGui.PlayerListMaster in 2024,
-- CoreGui.PlayerList on later clients.
local function FindPlayerListFrame()
    -- Not ipairs over a literal: a missing first root is nil and
    -- would end the loop before the second one is checked.
    local Roots = {
        RobloxGui and RobloxGui:FindFirstChild("PlayerListMaster") or false,
        CoreGui:FindFirstChild("PlayerList") or false,
    }

    for _, Root in ipairs(Roots) do
        local Offset = Root and Root:FindFirstChild("OffsetFrame", true)
        local Frame = Offset and Offset.Parent

        if Frame and Frame:IsA("GuiObject") then
            return Frame
        end
    end

    return nil
end

