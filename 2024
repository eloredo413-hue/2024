--============================================================
-- CONNECTION TRACKING
--============================================================

local Connections = {}
local Alive = true

local function Connect(Signal, Callback)
    if Signal == nil then
        return nil
    end

    local Ok, Connection = pcall(function()
        return Signal:Connect(Callback)
    end)

    if not Ok or not Connection then
        -- CoreScript signal objects (SettingsHub) use :connect.
        Ok, Connection = pcall(function()
            return Signal:connect(Callback)
        end)
    end

    if Ok and Connection then
        table.insert(Connections, Connection)
        return Connection
    end

    return nil
end

local function DisconnectAll()
    Alive = false

    for _, Connection in ipairs(Connections) do
        if not pcall(function()
            Connection:Disconnect()
        end) then
            pcall(function()
                Connection:disconnect()
            end)
        end
    end

    table.clear(Connections)
end

--============================================================
-- DISABLE ORIGINAL TOPBARAPP ONLY
--
-- This is the ONLY Roblox UI that is disabled. Chat, PlayerList,
-- Backpack, Emotes and RobloxGui are never touched.
--============================================================

-- The native bars are only collected here. They are disabled once
-- the replacement has loaded, so a failed download can no longer
-- leave the player with no top bar at all.

local NativeTopBars = {}
local WatchedTopBars = {}

local function IsNativeTopBar(Object)
    return Object.Name == "TopBarApp"
        and Object:IsA("LayerCollector")
        and not IsOurs(Object)
end

local function DisableNativeTopBar(Object)
    if not table.find(NativeTopBars, Object) then
        table.insert(NativeTopBars, Object)
    end

    if not WatchedTopBars[Object] then
        WatchedTopBars[Object] = true

        -- Keep it disabled if anything turns it back on.
        Connect(Object:GetPropertyChangedSignal("Enabled"), function()
            if Alive and Object.Enabled then
                pcall(function()
                    Object.Enabled = false
                end)
            end
        end)
    end

    pcall(function()
        Object.Enabled = false
    end)
end

for _, Object in ipairs(CoreGui:GetDescendants()) do
    if IsNativeTopBar(Object) then
        table.insert(NativeTopBars, Object)
    end
end

