local function WaitForMenu(Open, Timeout)
    local Deadline = os.clock() + Timeout

    while Alive and GuiService.MenuIsOpen ~= Open and os.clock() < Deadline do
        task.wait()
    end

    return GuiService.MenuIsOpen == Open
end

-- Opens or closes the Escape menu, preferring paths that do not
-- send key events. Yields while it waits for the menu.
local function SetEscapeMenuOpen(Open)
    if GuiService.MenuIsOpen == Open then
        return true
    end

    local Settings = Native.Settings

    if Settings
        and pcall(function()
            Settings:SetVisibility(Open)
        end)
        and WaitForMenu(Open, 0.5)
    then
        return true
    end

    if FireNativeMenuButton() and WaitForMenu(Open, 0.5) then
        return true
    end

    return SendKey(Enum.KeyCode.Escape, true) and WaitForMenu(Open, 1)
end

-- ChromeUtils.dismissRobloxMenuAndRun: opening a panel first
-- closes the Escape menu.
local function DismissMenu()
    if GuiService.MenuIsOpen then
        SetEscapeMenuOpen(false)
    end
end

-- Each list is tried in order. A step returns true when it made
-- an attempt; the next step only runs if the native state did not
-- follow, which is what makes mobile work when a path is missing.
local Steps = {}

Steps.chat = {
    function(Desired)
        if Desired then
            DismissMenu()
        end

        StarterGui:SetCore("ChatActive", Desired)

        return true
    end,
}

Steps.leaderboard = {
    function(Desired)
        local Controller = Native.PlayerList

        if not Controller then
            return false
        end

        if Desired then
            DismissMenu()
        end

        Controller:SetVisibility(Desired)

        return true
    end,

    function()
        return ActivateChromeIntegration("leaderboard")
    end,

    function(Desired)
        -- The native Tab handler passes on small touch screens.
        if IsSmallTouchScreen() then
            return false
        end

        if Desired then
            DismissMenu()
        end

        return SendKey(Enum.KeyCode.Tab)
    end,

    function()
        return FireNativeHitArea("leaderboard")
    end,
}

Steps.backpack = {
    function(Desired)
        local Module = Native.Backpack
        local OpenClose = Module and rawget(Module, "OpenClose")

        if type(OpenClose) ~= "function" then
            return false
        end

        if Desired then
            DismissMenu()
        end

        if rawget(Module, "IsOpen") ~= Desired then
            OpenClose(Module)
        end

        return true
    end,

    function()
        return ActivateChromeIntegration("backpack")
    end,

    function(Desired)
        if Desired then
            DismissMenu()
        end

        return CallNativeKeyHandler("BackpackScript", Enum.KeyCode.Backquote)
    end,

    function(Desired)
        if Desired then
            DismissMenu()
        end

        return SendKey(Enum.KeyCode.Backquote)
    end,

    function()
        return FireNativeHitArea("backpack")
    end,
}

Steps.emotes = {
    function(Desired)
        if Desired then
            DismissMenu()
        end

        GuiService:SetEmotesMenuOpen(Desired)

        return true
    end,

    function()
        return ActivateChromeIntegration("emotes")
    end,
}

local function WaitForState(Reader, Desired, Timeout)
    local Deadline = os.clock() + Timeout

    while Alive and os.clock() < Deadline do
        local Value = Reader()

        if Value == nil or Value == Desired then
            return Value
        end

        task.wait(0.05)
    end

    return Reader()
end

local function RunAction(Id, Desired)
    local Reader = Readers[Id]

    State.Active[Id] = Desired
    State.LockUntil[Id] = os.clock() + 0.6
    UpdateIconStates()

    task.spawn(function()
        for _, Step in ipairs(Steps[Id] or {}) do
            if not Alive then
                return
            end

            if Reader and Reader() == Desired then
                break
            end

            local Ok, Attempted = pcall(Step, Desired)

            if Ok and Attempted then
                State.LockUntil[Id] = os.clock() + 0.6

                local Result = Reader and WaitForState(Reader, Desired, 0.4)

                if Result == nil or Result == Desired then
                    break
                end
            end
        end

        if Reader and Reader() ~= Desired then
            Log("No native path changed", Id, "to", Desired)
        end

        State.LockUntil[Id] = 0
        SyncNativeState()
    end)
end

local function ToggleIntegration(Id)
    local Reader = Readers[Id]
    local Current = Reader and Reader()

    if Current == nil then
        Current = State.Active[Id]
    end

    RunAction(Id, not Current)
end

