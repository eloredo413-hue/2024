--============================================================
-- INTERACTABLE (UIBlox ControlState)
--============================================================
-- Default / Hover / Pressed. Hover only exists for a mouse; on
-- touch the highlight shows while pressed and clears on release,
-- so it can no longer get stuck on after a tap.
--============================================================

local function BindInteractable(Button, OnChanged)
    if not Button or not Button:IsA("GuiObject") then
        return nil
    end

    local Control = {
        Hovered = false,
        Pressed = false,
        Disabled = false,
        Last = "Default",
    }

    local function Emit()
        local Name = "Default"

        if not Control.Disabled then
            if Control.Pressed then
                Name = "Pressed"
            elseif Control.Hovered then
                Name = "Hover"
            end
        end

        if Control.Last ~= Name then
            Control.Last = Name
            OnChanged(Name)
        end
    end

    Control.Emit = Emit

    function Control.Reset(KeepHover)
        Control.Pressed = false

        if not KeepHover then
            Control.Hovered = false
        end

        Emit()
    end

    Connect(Button.MouseEnter, function()
        if MouseHoverAllowed() then
            Control.Hovered = true
            Emit()
        end
    end)

    Connect(Button.MouseLeave, function()
        Control.Hovered = false
        Control.Pressed = false
        Emit()
    end)

    Connect(Button.InputBegan, function(Input)
        local Type = Input.UserInputType

        if Type == Enum.UserInputType.MouseButton1
            or Type == Enum.UserInputType.Touch
        then
            Control.Pressed = true
            Emit()
        end
    end)

    Connect(Button.InputEnded, function(Input)
        local Type = Input.UserInputType

        if Type == Enum.UserInputType.MouseButton1
            or Type == Enum.UserInputType.Touch
        then
            Control.Pressed = false

            if Type == Enum.UserInputType.Touch then
                Control.Hovered = false
            end

            Emit()
        end
    end)

    table.insert(Interactables, Control)

    return Control
end

local function ResetInteractables(KeepHover)
    for _, Control in ipairs(Interactables) do
        Control.Reset(KeepHover)
    end
end

local function OnActivated(Button, Callback)
    if not Button or not Button:IsA("GuiButton") then
        return
    end

    SetProperty(Button, "Active", true)
    SetProperty(Button, "Interactable", true)

    Connect(Button.Activated, function()
        if not Alive then
            return
        end

        State.LastOwnActivation = os.clock()
        Callback()
    end)
end

